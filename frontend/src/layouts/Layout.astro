---
import { Image } from 'astro:assets';
import logoImageColor from '../assets/image/logo-color.png';
import logoNameColor from '../assets/image/logo-name-color.png';
import logoImageByN from '../assets/image/logo-full-byn.png';
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Digital Garden</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Oswald:wght@200..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    </head>
    <body>
        
        <header class="container-navbar">
            <div class="nav-wrapper">
                <div class="container-logo">
                    <a href="/" class="logo-link">
                        <Image src={logoImageColor} alt="Logo" class="logo-navbar" />
                        <Image src={logoNameColor} alt="Digital Garden" class="logo-name" />
                    </a>
                </div>

                <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>

                <nav class="content-nav" id="nav-menu">
                    <!--Nav no user -->
                    <ul class="guest-only hidden">
                        <li><a href="/home">Inicio</a></li>
                        <li><a href="/contact">Quiero publicar</a></li>
                        <li class="mobile-only"><a href="/login" class="btn-login">Ingresar</a></li>
                        <li><a href="/register" class="btn-register">Registrarse</a></li>
                    </ul>
                    <!--Nav user -->
                    <ul class="user-only hidden">
                        <li>
                            <a href="./home" class="btn-profile">Inicio</a>
                        </li>
                        <li>
                            <a href="./contact" class="btn-settings">Planes</a>
                        </li>
                        <li>
                            <a href="./dashboard" class="btn-dashboard">Mis notas</a>
                        </li>
                        <li>
                           <button class="btn-register" id="global-logout-btn" >Cerrar sesión</button>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>

        <main class="page-content">
            <slot />
        </main>

        <footer class="container-footer">
            <div class="footer-grid">
                
                <div class="footer-brand">
                    <Image src={logoImageByN} alt="Logo Digital Garden" class="logo-footer" />
                    <p class="brand-desc">Cultivando conocimiento digital.</p>
                </div>

                <div class="footer-links">
                    <div class="link-column">
                        <h3>Explorar</h3>
                        <ul>
                            <li><a href="/home">Inicio</a></li>
                        </ul>
                    </div>
                    <div class="link-column">
                        <h3>Comunidad</h3>
                        <ul>
                            <li><a href="/contact">Publicar nota</a></li>
                            <li><a href="/guidelines">Guías de autor</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-social">
                    <h3>Síguenos</h3>
                    <ul class="social-icons">
                        <li>
                            <a href="#" aria-label="Instagram">
