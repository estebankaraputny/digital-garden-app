							</a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="content-legal-footer">
                <div class="legal-links">
                    <a href="/privacy">Privacidad</a>
                    <span class="separator">•</span>
                    <a href="/security">Seguridad</a>
                </div>
                <p>© 2025 Digital Garden. Copyright.</p>
            </div>
        </footer>

    </body>
</html>

<script>
    // Navegacion
    const token = localStorage.getItem('token');
    const guestItems = document.querySelectorAll('.guest-only');
    const userItems = document.querySelectorAll('.user-only');
    const logoutBtn = document.getElementById('global-logout-btn');
    // Script para el menú hamburguesa  
    const hamburger = document.getElementById('hamburger-btn');
    const navMenu = document.getElementById('nav-menu');

    if (token) {
        // LOGEADO
        guestItems.forEach(el => el.classList.add('hidden'));
        userItems.forEach(el => el.classList.remove('hidden'));
    } else {
        // NO LOGUEADO
        guestItems.forEach(el => el.classList.remove('hidden'));
        userItems.forEach(el => el.classList.add('hidden'));
    }

    if (hamburger && navMenu) {
        hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        navMenu.classList.toggle('active');
        document.body.classList.toggle('no-scroll');
    });

    // Cerrar menú al hacer click en un enlace
    document.querySelectorAll('.nav-link').forEach(n => n.addEventListener('click', () => {
        hamburger.classList.remove('active');
        navMenu.classList.remove('active');
    }));
    }

     // cerrar sesión
    logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem('token');
        window.location.href = '/home';
    });

</script>

<style>
    :root{
        --primary-color: #fdfcfa;
        --secondary-color: #447d4b;
        --tertiary-color: #08453c;
        --quaternary-color: #e8f5e9;
        --background-color: #F4EEE5;
        --color-text-primary: #262626;
        --color-text-secondary: #141414;
        --color-text-light: #666666;
        --black-color: #000000;
        --white-color: #ffffff;
        --border-color: #E7E7E7;
        --green-light: #e8f5e9;
        --navbar-height: 4rem;
        --border-radius: 1rem;
    }

    * {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        background-color: var(--primary-color);
        font-family: 'Figtree', sans-serif;
        color: var(--color-text-primary);
        display: grid;
        min-height: 100dvh;
        grid-template-rows: auto 1fr auto;
        /* grid-template-columns: 1fr; */
    }
    body.no-scroll {
        overflow: hidden;
    }

    main{
        flex-grow: 1;
    }

    /* --- HEADER & NAVBAR --- */
    .container-navbar {
        background-color: rgba(253, 252, 250, 0.95);
        backdrop-filter: blur(10px);
        position: fixed;
        width: 100%;
        z-index: 1000;
        top: 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        height: var(--navbar-height);
        display: flex;
        align-items: center;
    }

    .nav-wrapper {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Logo */
    .logo-link {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
    }

    .logo-navbar {
        width: 2.5rem;
        height: auto;
    }

    .logo-name {
        width: 8rem;
        height: auto;
        margin-top: 4px; 
    }

    /* Navegación Desktop */
    .content-nav ul {
        display: flex;
        list-style: none;
        gap: 2rem;
        align-items: center;
    }

    .content-nav a {
        text-decoration: none;
        color: var(--color-text-primary);
        font-weight: 500;
        font-size: 1rem;
        transition: color 0.3s ease;
        position: relative;
    }

    .content-nav a:hover {
        color: var(--secondary-color);
    }

	.btn-login {
		padding: 0.5rem 1rem;
		background-color: var(--secondary-color);
		color: var(--white-color) !important;
		border: none;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: background-color 0.3s ease;
	}

	.btn-login:hover {
		background-color: var(--tertiary-color);
	}

    .btn-register{
        padding: 0.5rem 1rem;
        border: 1px solid var(--secondary-color);
        border-radius: 8px;
    }

    .btn-register:hover{
        background-color: var(--secondary-color);
        color: var(--white-color) !important;
    }
     
    /**nav segun cuenta */
    .hidden { 
        display: none !important; 
    }
    .navbar { 
        display: flex;
        justify-content: space-between;
        padding: 1rem; 
        border-bottom: 1px solid #eee; 
    }

    .menu-items { 
        display: flex; 
        gap: 1rem; 
        align-items: center; 
    }

    button { 
        background: none; 
        cursor: pointer; 
    }

    /* --- HAMBURGER MENU (Móvil) --- */
    .hamburger {
        display: none; /* Oculto en desktop */
        cursor: pointer;
        background: none;
        border: none;
    }

    .bar {
        display: block;
        width: 25px;
        height: 3px;
        margin: 5px auto;
        transition: all 0.3s ease-in-out;
        background-color: var(--black-color);
        border-radius: 2px;
    }

    /* Animación Hamburguesa */
    .hamburger.active .bar:nth-child(2) { opacity: 0; }
    .hamburger.active .bar:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .hamburger.active .bar:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    /* Espacio para que el contenido no quede debajo del header fijo */
    .page-content {
        padding-top: 4rem;
        /* flex: 1; */
    }

    /* --- FOOTER --- */
    .container-footer {
        background-color: var(--white-color);
        border-top: 1px solid var(--border-color);
        padding: 4rem 1.5rem 1rem;
        margin-top: auto;
    }

    .footer-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 2fr 1fr; /* Logo - Links - Social */
        gap: 2rem;
        margin-bottom: 3rem;
    }

    /* 1. Brand */
    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .brand-desc {
        font-size: 0.9rem;
        color: var(--color-text-light);
        max-width: 200px;
    }

	.logo-footer{
			width: 5rem;
			height: auto
	}

    /* 2. Links */
    .footer-links {
        display: flex;
        justify-content: space-around;
        gap: 2rem;
    }
    .link-column h3 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: var(--tertiary-color);
    }
    .link-column ul {
        list-style: none;
    }
    .link-column li {
        margin-bottom: 0.6rem;
    }
    .link-column a {
        text-decoration: none;
        color: var(--color-text-light);
        font-size: 0.95rem;
        transition: color 0.2s;
    }
    .link-column a:hover {
        color: var(--secondary-color);
    }

    /* 3. Social */
    .footer-social h3 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: var(--tertiary-color);
    }
    .social-icons {
        display: flex;
        gap: 1rem;
        list-style: none;
    }
    .social-icons svg {
        width: 1.5rem;
        height: 1.5rem;
        fill: var(--color-text-light);
        transition: fill 0.3s, transform 0.3s;
    }
    .social-icons a:hover svg {
        fill: var(--secondary-color);
        transform: translateY(-3px);
    }

    /* Legal */
    .content-legal-footer {
        max-width: 1200px;
        margin: 0 auto;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--color-text-light);
        font-size: 0.85rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .legal-links a {
        text-decoration: none;
        color: inherit;
    }
    .separator { margin: 0 0.5rem; }


    /* --- MEDIA QUERIES (RESPONSIVE) --- */
    @media (max-width: 768px) {
        /* Header Móvil */
        .hamburger {
            display: block; /* Mostrar botón */
            z-index: 1001;
        }

        .content-nav {
            position: fixed;
            left: -100%;
            top: 0; /* Desde el top 0 para cubrir todo */
            gap: 0;
            flex-direction: column;
            background-color: var(--primary-color);
            width: 100%;
            height: 100vh; /* Pantalla completa */
            text-align: center;
            transition: 0.3s;
            justify-content: center; /* Centrar verticalmente */
            padding-top: var(--navbar-height); /* Espacio para que no tape el logo */
        }

        .content-nav.active {
            left: 0;
        }

        .content-nav ul {
            flex-direction: column;
            gap: 2.5rem;
        }

        .content-nav a {
            font-size: 1.5rem; /* Texto más grande en móvil */
        }

        .mobile-only {
            margin-top: 1rem;
        }

        /* Footer Móvil */
        .footer-grid {
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            text-align: center;
        }

        .footer-links {
            flex-direction: column;
            gap: 2rem;
        }

        .footer-brand {
            align-items: center;
            order: 1; /* Logo primero */
        }
        
        .footer-links {
            order: 2; /* Links segundo */
        }

        .footer-social {
            order: 3; /* Redes AL FINAL (como pediste) */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .content-legal-footer {
            flex-direction: column-reverse; /* Copyright abajo de todo lo legal */
            text-align: center;
        }
    }
</style>