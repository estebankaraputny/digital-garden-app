---
---
<section class="section-create">
      <form id="note-form">
        <label for="title">
          <input
            type="text"
            name="title"
            id="title"
            placeholder="Titulo"
            required
          />
        </label>

        <label for="content">
          <textarea
            name="content"
            id="content"
            placeholder="Descripcion"
            required></textarea>
        </label>

        <label for="category">
          <select name="category" id="category" required>
            <option value="Criptomonedas y Web3">Criptomonedas y Web3</option>
            <option value="Ciberseguridad y Privacidad">Ciberseguridad y Privacidad</option>
            <option value="Crianza y Familia">Crianza y Familia</option>
            <option value="Desarrollo de Software y No-Code">Desarrollo de Software y No-Code</option>
            <option value="Desarrollo Personal y Liderazgo">Desarrollo Personal y Liderazgo</option>
            <option value="Emprendimiento y Startups">Emprendimiento y Startups</option>
            <option value="Fitness, Nutrición y Biohacking">Fitness, Nutrición y Biohacking</option>
            <option value="Finanzas Personales e Inversiones">Finanzas Personales e Inversiones</option>
            <option value="Idiomas y Aprendizaje Acelerado">Idiomas y Aprendizaje Acelerado</option>
            <option value="Inteligencia Artificial (IA) y Prompt Engineering">Inteligencia Artificial (IA) y Prompt Engineering</option>  
            <option value="Moda y Estilo Personal">Moda y Estilo Personal</option>
            <option value="Marketing Digital y Marca Personal">Marketing Digital y Marca Personal</option>
            <option value="Productividad y Gestión del Conocimiento">Productividad y Gestión del Conocimiento</option>
            <option value="Salud Mental y Psicología">Salud Mental y Psicología</option>
            <option value="Salud">Salud</option>
            <option value="Viajes y Nómadas Digitales">Viajes y Nómadas Digitales</option>
          </select>
        </label>

        <label for="issue">
          <input
            type="text"
            name="issue"
            id="issue"
            placeholder="Tema"
            required
          />
        </label>

        <label for="status">
          Estado
          <select name="status" id="status" required>
            <option value="Pendiente">Pendiente</option>
            <option value="En proceso">En Proceso</option>
            <option value="Terminado">Terminado</option>
          </select>
        </label>

        <button type="submit" id="submit-btn"> Crear Nota </button>

        <p id="error-form-message" class="error-text hidden"></p>
      </form>
</section>

<script>

  import fetchDataPostWithToken from "../../lib/api/fetchDataPostWithToken";


  const form = document.getElementById("note-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-form-message") as HTMLParagraphElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  // console.log(form);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    btn.disabled = true;
    btn.textContent = "Cargando...";

    //Capturamos los datos del formulario automáticamente
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    if (data.issue && typeof data.issue === 'string') {
      data.title = data.title.charAt(0).toUpperCase() + data.title.slice(1).toLowerCase();
      data.content = data.content.charAt(0).toUpperCase() + data.content.slice(1).toLowerCase();
      data.issue = data.issue.charAt(0).toUpperCase() + data.issue.slice(1).toLowerCase();
    }


    try {
      const myToken: any = localStorage.getItem("token");

      const response = await fetchDataPostWithToken("notes", data, myToken);
      // console.log("Respuesta:", response);

      if (response && response.id) {
         alert('¡Nota creada con éxito!')
        window.location.href = "dashboard";
      } else {
        throw new Error("Error al crear la nota");
      }
    } catch (error: any) {
        // console.log("Error form:", error.message);
        if (errorMsg) errorMsg.textContent = error.message;
        if (errorMsg) errorMsg.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = "Crear Nota";
    }
  });
</script>

<style>
  /* 
  section {
    background: #f4f4f5;
    padding: 2rem;
    border-radius: 8px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  } */

  .section-create {
    /* background: #f4f4f5; */
    border-radius: 8px;
    width: 100%;
    margin: auto;
  }

  .title-note{
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    display: flex;
    flex-direction: column;
    font-weight: 500;
    font-size: 0.9rem;
  }

  input, select, textarea {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    margin-top: 0.25rem;
    border-radius: .3rem;
  }

  select {
    width: 100%;
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
        outline: 1px solid #000;
  }

  textarea{
    resize: none;
    height: 7rem;
    font-family: 'Figtree', sans-serif;
  }

  button {
    background-color: #2a9158;
    color: white;
    padding: 0.75rem;
    border: none;
    border-radius: 1rem;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #333;
  }

  button:disabled {
    background-color: #666;
    cursor: not-allowed;
  }

  .error-text {
    color: #dc2626;
    font-size: 0.875rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .hidden {
    display: none;
  }

</style>