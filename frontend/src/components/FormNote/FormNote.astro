---
---
<section class="section-create">
      <h1 class="title-note">Crear Nota</h1>
      <form id="note-form">
        <label for="title">
          <input
            type="text"
            name="title"
            id="title"
            placeholder="Titulo"
            required
          />
        </label>

        <label for="content">
          <textarea
            name="content"
            id="content"
            placeholder="Descripcion"
            required></textarea>
        </label>

        <label for="category">
          <input
            type="text"
            name="category"
            id="category"
            placeholder="Categoria"
            required
          />
        </label>

        <label for="issue">
          <input
            type="text"
            name="issue"
            id="issue"
            placeholder="Tema"
            required
          />
        </label>

        <label for="status">
          Estado
          <select name="status" id="status" required>
            <option value="pendiente">Pendiente</option>
            <option value="en proceso">En Proceso</option>
            <option value="terminado">Terminado</option>
          </select>
        </label>

        <button type="submit" id="submit-btn"> Crear Nota </button>

        <p id="error-message" class="hidden error-text"></p>
      </form>
</section>

<script>

  import fetchDataPostWithToken from "../../lib/api/fetchDataPostWithToken";


  const form = document.getElementById("note-form") as HTMLFormElement;
  const errorMsg = document.getElementById(
    "error-message"
  ) as HTMLParagraphElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    errorMsg.textContent = "";
    errorMsg.classList.add("hidden");
    btn.disabled = true;
    btn.textContent = "Cargando...";

    // 3. Capturamos los datos del formulario automáticamente
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    console.log(data);

    try {
      const myToken = localStorage.getItem("token");

      const response = await fetchDataPostWithToken("notes", data, myToken);
      console.log("Respuesta:", response);

      if (response && response.id) { // Verifica si la respuesta es válida y tiene un ID
        window.location.href = "dashboard"; // Redirige si la nota se creó con éxito
      } else {
        throw new Error("Error al crear la nota");
      }
    } catch (error) {
      console.error(error);
      errorMsg.textContent = "Credenciales incorrectas o error de servidor.";
      errorMsg.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Crear Nota";
    }
  });
</script>

<style>
  /* 
  section {
    background: #f4f4f5;
    padding: 2rem;
    border-radius: 8px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  } */

  .section-create {
    /* background: #f4f4f5; */
    padding: 2rem;
    border-radius: 8px;
    width: 80%;
    margin: auto;
    padding: 2rem;
  }

  .title-note{
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    display: flex;
    flex-direction: column;
    font-weight: 500;
    font-size: 0.9rem;
  }

  input, select {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-top: 0.25rem;
    border-radius: 1rem;
  }

    input:focus-visible, select:focus-visible, textarea:focus-visible {
        outline: 1px solid #000;
  }

  textarea{
    padding: .5rem;
    border-radius: 1rem;
    border: 1px solid #ccc;
    resize: none;
    height: 7rem;
  }

  button {
    background-color: #2a9158;
    color: white;
    padding: 0.75rem;
    border: none;
    border-radius: 1rem;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #333;
  }

  button:disabled {
    background-color: #666;
    cursor: not-allowed;
  }

  .error-text {
    color: #dc2626;
    font-size: 0.875rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .hidden {
    display: none;
  }
</style>