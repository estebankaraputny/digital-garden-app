        if (notesData.length === 0) {
          renderPage(1);
          noNotesMsg!.classList.remove("hidden");
        } else {
          if (currentPage > totalPages) currentPage = totalPages;
          renderPage(currentPage);
        }

        } catch (error) {
          alert("Error al eliminar");
        }
      });
    });
