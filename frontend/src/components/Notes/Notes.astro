  }

   // Función para borrar
  const activateDeleteButtons = () => {
    const buttons = document.querySelectorAll(".delete-btn");
    
    buttons.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        
        if (!confirm("¿Estás seguro de borrar esta nota?")) return;
        
        const id = target.dataset.id;
        try {
          await fetchDataDelete(`notes/${id}`, myToken!);

        // Actualizamos los datos locales y re-renderizamos
        notesData = notesData.filter(n => n.id !== id);
        totalPages = Math.ceil(notesData.length / ITEMS_PER_PAGE);

        if (notesData.length === 0) {
          renderPage(1);
          noNotesMsg!.classList.remove("hidden");
        } else {
          if (currentPage > totalPages) currentPage = totalPages;
          renderPage(currentPage);
        }

        } catch (error) {
          alert("Error al eliminar");
        }
      });
    });
  };

  //Menu card

  const activateMenus = () => {
    // 1. Seleccionamos todos los botones de tres puntos
    const triggers = document.querySelectorAll('.menu-trigger-card');

    triggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // Buscamos el menú hermano de este botón
            const dropdown = trigger.nextElementSibling;
            
            // Cerramos CUALQUIER otro menú abierto antes de abrir este (opcional pero recomendado)
            document.querySelectorAll('.menu-dropdown').forEach(m => {
                if (m !== dropdown) m.classList.add('hidden');
            });

            // Alternamos la visibilidad
            if(dropdown) dropdown.classList.toggle('hidden');
        });
    });
};

