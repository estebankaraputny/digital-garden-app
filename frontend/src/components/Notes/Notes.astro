---
import "../Notes/notes.css"
---

  <section class="section-container-card">

    <div id="notes-container" class="notes-container">
      <p class="loading-text">Cargando tus notas...</p>
    </div>

    <p id="no-notes-msg" class="hidden">No hay notas para mostrar.</p>

    <article class="modal-edit hidden" id="modal-edit">
    
      
      <form id="note-form-edit" class="form-edit">
        <h2>Editar nota</h2>
        <label for="title">
          <input
            type="text"
            name="title"
            id="title"
            placeholder="Titulo"
            required
          />
        </label>

        <label for="content">
          <textarea
            name="content"
            id="content"
            placeholder="Descripcion"
            required></textarea>
        </label>

        <label for="category">
          <select name="category" id="category" required class="category-edit">
            <option value="Criptomonedas y Web3">Criptomonedas y Web3</option>
            <option value="Ciberseguridad y Privacidad">Ciberseguridad y Privacidad</option>
            <option value="Crianza y Familia">Crianza y Familia</option>
            <option value="Desarrollo de Software y No-Code">Desarrollo de Software y No-Code</option>
            <option value="Desarrollo Personal y Liderazgo">Desarrollo Personal y Liderazgo</option>
            <option value="Emprendimiento y Startups">Emprendimiento y Startups</option>
            <option value="Fitness, Nutrición y Biohacking">Fitness, Nutrición y Biohacking</option>
            <option value="Finanzas Personales e Inversiones">Finanzas Personales e Inversiones</option>
            <option value="Idiomas y Aprendizaje Acelerado">Idiomas y Aprendizaje Acelerado</option>
            <option value="Inteligencia Artificial (IA) y Prompt Engineering">Inteligencia Artificial (IA) y Prompt Engineering</option>  
            <option value="Moda y Estilo Personal">Moda y Estilo Personal</option>
            <option value="Marketing Digital y Marca Personal">Marketing Digital y Marca Personal</option>
            <option value="Productividad y Gestión del Conocimiento">Productividad y Gestión del Conocimiento</option>
            <option value="Salud Mental y Psicología">Salud Mental y Psicología</option>
            <option value="Salud">Salud</option>
            <option value="Viajes y Nómadas Digitales">Viajes y Nómadas Digitales</option>
          </select>
        </label>

        <label for="issue">
          <input
            type="text"
            name="issue"
            id="issue"
            placeholder="Tema"
            required
          />
        </label>

        <label for="status">
          Estado
          <select name="status" id="status" required>
            <option value="Pendiente">Pendiente</option>
            <option value="En proceso">En Proceso</option>
            <option value="Terminado">Terminado</option>
          </select>
        </label>

        <div class="btn-content"> 

          <button type="submit" id="submit-edit-btn" class="btn-save"> Guardar</button>
          <button type="button" id="cancel-edit-btn" class="btn-cancel">Cancelar</button>
        </div>

        <p id="error-form-message-edit" class="error-text hidden"></p>
      </form>
    
    </article>
  </section>

<script>
  // Importamos las funciones necesarias
  import fetchDataGetWithToken from "../../lib/api/fetchDataGetWithToken";
  import fetchDataPatch from "../../lib/api/fetchDataPatch";
  import fetchDataDelete from "../../lib/api/fetchDataDelete";


  // ---LÓGICA DE DATOS ---
  const container = document.getElementById("notes-container");
  const noNotesMsg = document.getElementById("no-notes-msg");
  const myToken = localStorage.getItem("token");
  const modalEdit = document.getElementById("modal-edit") as HTMLElement;
  const formEdit = document.getElementById("note-form-edit") as HTMLFormElement;
  const btnEdit = document.getElementById("submit-edit-btn") as HTMLButtonElement;
  const btnCancel = document.getElementById("cancel-edit-btn") as HTMLButtonElement;
  const errorMsg = document.getElementById("error-form-message-edit") as HTMLParagraphElement;

//ORDENAR
const sortNotesByDate = (notes : any[]) => {
    // Creamos una copia con slice() para no mutar el original inesperadamente
    return notes.slice().sort((a, b) => {
      // Orden Descendente: El más nuevo (fecha mayor) primero
      return new Date(b.createdAt) - new Date(a.createdAt);
    });
  };

  // Función para generar el HTML de una tarjeta
  const createNoteCard = (note : any) => {

    const authorName = note.author?.name || "Usuario";
    const initial = authorName.charAt(0).toUpperCase();
  
    return `
      <article class="note-card" id="${note.id}">
        <div class="card-header">

        <div class="user-info">
                <div class="avatar-circle">${initial}</div>
                <div class="user-meta">
                    <span class="user-name">${authorName}</span>
                    <div class="post-meta">
                        <time datetime="${note.createdAt}">${timeAgo(note.createdAt)}</time>
                        <span>•</span>
                        <span class="status-text}">
                           ${note.status || 'Borrador'}
                        </span>
                    </div>
                </div>
        </div>


            <div class="card-actions-wrapper">
              <button class="menu-trigger-card">
                <svg class="points-options" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 208C289.1 208 264 182.9 264 152C264 121.1 289.1 96 320 96C350.9 96 376 121.1 376 152C376 182.9 350.9 208 320 208zM320 432C350.9 432 376 457.1 376 488C376 518.9 350.9 544 320 544C289.1 544 264 518.9 264 488C264 457.1 289.1 432 320 432zM376 320C376 350.9 350.9 376 320 376C289.1 376 264 350.9 264 320C264 289.1 289.1 264 320 264C350.9 264 376 289.1 376 320z"/></svg>
              </button>

              <div class="menu-dropdown hidden">
                <button class="edit-btn menu-item" data-id="${note.id}" type="button" title="Editar nota"> Editar </button>
                <button class="delete-btn menu-item" data-id="${note.id}" type="button" title="Eliminar nota">
                  Eliminar
                </button>
                <button class="menu-item" type="button" title="Compartir">Compartir</button>
              </div>
              </div>

        </div>
        <div class="note-body">
          <h2 class="note-title">${note.title}</h2>
          <p class="note-content">${note.content}</p>
        </div>
        

        <div class="note-footer">
            <div class="badges-container">
                <span class="pill-badge category-pill">${note.category || 'General'}</span>
                ${note.issue ? `<span class="pill-badge issue-pill">#${note.issue}</span>` : ''}
            </div>
        </div>
      </article>
      
    `;
  };

  const loadNotes = async () => {
    if (!myToken) {
      window.location.href = "/login";
      return;
    }

    try {
      // Fetch al backend
      const userNotes = await fetchDataGetWithToken("notes/user-notes", myToken);

      if (!userNotes || userNotes.length === 0) {
        container!.innerHTML = ""; 
        noNotesMsg!.classList.remove("hidden");
        return;
      }

      // APLICAR ORDENAMIENTO ANTES DE PINTAR
      const sortedNotes = sortNotesByDate(userNotes);
      // Inyectar HTML
      container.innerHTML = sortedNotes.map((note) => createNoteCard(note)).join("");

      // ACTIVAR BOTONES DE EDITAR Y BORRAR---
      activateEditButton();
      activateDeleteButtons();
      activateMenus();


    } catch (error) {
      console.error("Error:", error);
      container!.innerHTML = `<p class="error-msg">Error al cargar las notas.</p>`;
    }
  };

  //FUNCIONES AUXILIARES

  if(formEdit) {
    formEdit.addEventListener("submit", async(event) =>{
      event.preventDefault();

      if(!currentEditingId) return;

      btnEdit.disabled = true;
      btnEdit.textContent = "Cargando...";
      errorMsg.classList.add("hidden");

      const formData = new FormData(formEdit);
      const data = Object.fromEntries(formData);
      const idNote = currentEditingId;

      // console.log("edicion:", data);

      
      

      try{
        await fetchDataPatch("notes", data, myToken, idNote);
        // console.log("Respuesta:", response);
        updateCardDOM(currentEditingId, data);

        modalEdit.classList.add("hidden");
        alert("Nota actualizada con éxito");
        // window.location.reload();
      } catch (error: any){
        errorMsg.textContent = error.message;
        errorMsg.classList.remove("hidden");
        throw new Error(error.message);
      } finally{
        btnEdit.disabled = false;
        btnEdit.textContent = "Editar nota";
      }
    });
  }

  let currentEditingId : any = null;

  const openEditModal = (id: string, cardEdit: HTMLElement) =>{
    currentEditingId = id;

    const title = cardEdit.querySelector(".note-title")?.textContent;
    const content = cardEdit.querySelector(".note-content")?.textContent;
    const category = cardEdit.querySelector(".category-pill")?.textContent;
    const issue = cardEdit.querySelector(".issue-pill")?.textContent;
    const status = cardEdit.querySelector(".status-text")?.textContent;

    formEdit.title.value = title;
    formEdit.content.value = content;
    formEdit.category.value = category;
    formEdit.issue.value = issue;
    formEdit.status.value = status;

  
    modalEdit.classList.remove("hidden");

    const menu = cardEdit.querySelector(".menu-dropdown");
    if (menu) menu.classList.add("hidden");

  };

  //Función para editar

  const activateEditButton = () => {
    const buttons = document.querySelectorAll(".edit-btn");

    buttons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.stopPropagation();


        const target = event.currentTarget as HTMLButtonElement;
        const idNote : any = target.dataset.id;


        const card : any = target.closest(".note-card");

        openEditModal(idNote, card);
      });
    });
  }

   // Función para borrar
  const activateDeleteButtons = () => {
    const buttons = document.querySelectorAll(".delete-btn");
    
    buttons.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        
        if (!confirm("¿Estás seguro de borrar esta nota?")) return;
        
        const id = target.dataset.id;
        try {
          await fetchDataDelete(`notes/${id}`, myToken!);
          // Recargar página
          // window.location.reload();
          
          //Borrar el elemento del DOM sin recargar
          const card = document.getElementById(id!);
          card?.remove();
          
          // Si no quedan notas, mostrar mensaje
          if (document.querySelectorAll(".note-card").length === 0) {
             noNotesMsg!.classList.remove("hidden");
          }

        } catch (error) {
          alert("Error al eliminar");
        }
      });
    });
  };

  //Menu card

  const activateMenus = () => {
    // 1. Seleccionamos todos los botones de tres puntos
    const triggers = document.querySelectorAll('.menu-trigger-card');

    triggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // Buscamos el menú hermano de este botón
            const dropdown = trigger.nextElementSibling;
            
            // Cerramos CUALQUIER otro menú abierto antes de abrir este (opcional pero recomendado)
            document.querySelectorAll('.menu-dropdown').forEach(m => {
                if (m !== dropdown) m.classList.add('hidden');
            });

            // Alternamos la visibilidad
            if(dropdown) dropdown.classList.toggle('hidden');
        });
    });
};

//FUNCION CANCELAR EDIT

  if(btnCancel) {

    btnCancel.addEventListener("click", (event) => {
      // event.stopPropagation();
      event.preventDefault();

      modalEdit.classList.add("hidden");
      currentEditingId = null;
      formEdit.reset();
      errorMsg.classList.add("hidden");
      errorMsg.textContent = "";
    });
}

// Click fuera cierra menús
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.card-actions-wrapper')) {
        document.querySelectorAll('.menu-dropdown').forEach(menu => menu.classList.add('hidden'));
    }
    // Click fuera cierra modal (Opcional)
    if (e.target === modalEdit) {
        modalEdit.classList.add('hidden');
    }
  });

const updateCardDOM = (id: string, newData: any) => {
    const card = document.getElementById(id);
    if (!card) return;

    // 1. Actualizar Título (Verificamos que el elemento exista con ?)
    const titleEl = card.querySelector('.note-title');
    if (titleEl && newData.title) titleEl.textContent = newData.title;

    // 2. Actualizar Contenido
    const contentEl = card.querySelector('.note-content');
    if (contentEl && newData.content) contentEl.textContent = newData.content;

    // 3. Actualizar Categoría
    // ¡OJO! Aquí estaba el error probable: cambiamos la clase a .category-pill
    const categoryEl = card.querySelector('.category-pill'); 
    if (categoryEl && newData.category) categoryEl.textContent = newData.category;

    // 4. Actualizar Tema (Issue)
    // El issue es delicado porque a veces no existe en el HTML original
    const issueEl = card.querySelector('.issue-pill');
    
    if (newData.issue) {
        if (issueEl) {
            // Si ya existe el badge, solo cambiamos el texto
            issueEl.textContent = "#" + newData.issue.replace('#', '');
        } else {
            // Si NO existe (porque la nota no tenía tema), lo creamos dinámicamente
            // Buscamos el footer para inyectarlo ahí
            const footer = card.querySelector('.note-footer');
            if(footer) {
                const newSpan = document.createElement('span');
                newSpan.className = 'pill-badge issue-pill';
                newSpan.textContent = "#" + newData.issue.replace('#', '');
                footer.appendChild(newSpan);
            }
        }
    }

    // 5. Actualizar Estado
    const statusEl = card.querySelector('.status-badge');
    if (statusEl && newData.status) {
        statusEl.textContent = newData.status;
        // Actualizamos también el color (clases)
        statusEl.className = 'status-badge'; // Reset
        if(newData.status === 'Terminado') statusEl.classList.add('status-done');
        else if(newData.status === 'En proceso') statusEl.classList.add('status-process');
        else statusEl.classList.add('status-pending');
    }
};


  //Hora y fecha
  const timeAgo = (dateString: string) => {
  if (!dateString) return '';
  
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  
  const rtf = new Intl.RelativeTimeFormat('es-AR', { numeric: 'auto' });

  if (diffInSeconds < 60) {
    return rtf.format(-diffInSeconds, 'second');
  }
  
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) {
    return rtf.format(-diffInMinutes, 'minute');
  }
  
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) {
    return rtf.format(-diffInHours, 'hour');
  }
  
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 30) {
    return rtf.format(-diffInDays, 'day');
  }
  
  const diffInMonths = Math.floor(diffInDays / 30);
  if (diffInMonths < 12) {
    return rtf.format(-diffInMonths, 'month');
  }
  
  const diffInYears = Math.floor(diffInDays / 365);
  return rtf.format(-diffInYears, 'year');
  };

  // Ejecutar al cargar la página
  loadNotes();
</script>


