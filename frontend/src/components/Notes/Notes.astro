  const myToken = localStorage.getItem("token");
  const modalEdit = document.getElementById("modal-edit") as HTMLElement;
  const formEdit = document.getElementById("note-form-edit") as HTMLFormElement;
  const btnEdit = document.getElementById("submit-edit-btn") as HTMLButtonElement;
  const btnCancel = document.getElementById("cancel-edit-btn") as HTMLButtonElement;
  const errorMsg = document.getElementById("error-form-message-edit") as HTMLParagraphElement;

  // --- PAGINACIÓN ---
  const paginationContainer = document.getElementById("pagination-controls") as HTMLDivElement;
  const prevBtn = document.getElementById("prev-page-btn") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-page-btn") as HTMLButtonElement;
  const pageInfo = document.getElementById("page-info") as HTMLSpanElement;

  const ITEMS_PER_PAGE = 6; // ajustar si se quiere otro tamaño
  let currentPage = 1;
  let totalPages = 1;
  let notesData: any[] = [];

//ORDENAR
const sortNotesByDate = (notes : any[]) => {
    // Creamos una copia con slice() para no mutar el original inesperadamente
    return notes.slice().sort((a, b) => {
      // Orden Descendente: El más nuevo (fecha mayor) primero
      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
    });
  };

  // Función para generar el HTML de una tarjeta
  const createNoteCard = (note : any) => {

    const authorName = note.author?.name || "Usuario";
    const initial = authorName.charAt(0).toUpperCase();
  
    return `
      <article class="note-card" id="${note.id}">
        <div class="card-header">

        <div class="user-info">
                <div class="avatar-circle">${initial}</div>
                <div class="user-meta">
                    <span class="user-name">${authorName}</span>
                    <div class="post-meta">
                        <time datetime="${note.createdAt}">${timeAgo(note.createdAt)}</time>
                        <span>•</span>
                        <span class="status-badge ${note.status === 'Terminado' ? 'status-done' : note.status === 'En proceso' ? 'status-process' : 'status-pending'}">
                           ${note.status || 'Borrador'}
                        </span>
                    </div>
                </div>
        </div>


            <div class="card-actions-wrapper">
              <button class="menu-trigger-card">
                <svg class="points-options" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 208C289.1 208 264 182.9 264 152C264 121.1 289.1 96 320 96C350.9 96 376 121.1 376 152C376 182.9 350.9 208 320 208zM320 432C350.9 432 376 457.1 376 488C376 518.9 350.9 544 320 544C289.1 544 264 518.9 264 488C264 457.1 289.1 432 320 432zM376 320C376 350.9 350.9 376 320 376C289.1 376 264 350.9 264 320C264 289.1 289.1 264 320 264C350.9 264 376 289.1 376 320z"/></svg>
              </button>

              <div class="menu-dropdown hidden">
                <button class="edit-btn menu-item" data-id="${note.id}" type="button" title="Editar nota"> Editar </button>
                <button class="delete-btn menu-item" data-id="${note.id}" type="button" title="Eliminar nota">
                  Eliminar
                </button>
                <button class="menu-item" type="button" title="Compartir">Compartir</button>
              </div>
              </div>

        </div>
        <div class="note-body">
          <h2 class="note-title">${note.title}</h2>
          <p class="note-content">${note.content}</p>
        </div>
        

        <div class="note-footer">
            <div class="badges-container">
                <span class="pill-badge category-pill">${note.category || 'General'}</span>
                ${note.issue ? `<span class="pill-badge issue-pill">#${note.issue}</span>` : ''}
            </div>
        </div>
      </article>
      
    `;
  };

  const updatePaginationControls = () => {
    totalPages = Math.max(1, Math.ceil(notesData.length / ITEMS_PER_PAGE));
    if (!paginationContainer || !pageInfo || !prevBtn || !nextBtn) return;

    if (notesData.length <= ITEMS_PER_PAGE) {
      paginationContainer.classList.add("hidden");
    } else {
      paginationContainer.classList.remove("hidden");
    }

    pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
  };

  const renderPage = (page = 1) => {
    if (!container || !noNotesMsg) return;

    if (notesData.length === 0) {
      container.innerHTML = "";
      noNotesMsg.classList.remove("hidden");
      if (paginationContainer) paginationContainer.classList.add("hidden");
      return;
    }

    noNotesMsg.classList.add("hidden");
    totalPages = Math.ceil(notesData.length / ITEMS_PER_PAGE);
    currentPage = Math.min(Math.max(1, page), totalPages);

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;
    const pageNotes = notesData.slice(start, end);

    container.innerHTML = pageNotes.map((note) => createNoteCard(note)).join("");

    updatePaginationControls();

    // Re-activar handlers para los elementos recién renderizados
    activateEditButton();
    activateDeleteButtons();
    activateMenus();
  };

  if (prevBtn) prevBtn.addEventListener("click", () => { if (currentPage > 1) renderPage(currentPage - 1); });
  if (nextBtn) nextBtn.addEventListener("click", () => { if (currentPage < totalPages) renderPage(currentPage + 1); });

  const loadNotes = async () => {
    if (!myToken) {
      window.location.href = "/login";
      return;
    }

    try {
      // Fetch al backend
      const userNotes = await fetchDataGetWithToken("notes/user-notes", myToken);

      if (!userNotes || userNotes.length === 0) {
        container!.innerHTML = ""; 
        noNotesMsg!.classList.remove("hidden");
        return;
      }

      const sortedNotes = sortNotesByDate(userNotes);

      notesData = sortedNotes;
      totalPages = Math.ceil(notesData.length / ITEMS_PER_PAGE);
      currentPage = 1;
      renderPage(1);


    } catch (error: any) {
      console.error("Error:", error);if (error.message.includes("401") || error.message.toLowerCase().includes("unauthorized")) {
         alert("La sesión expiró. Por favor, ingresa nuevamente.");
         localStorage.removeItem("token");
         window.location.href = "/login";
         return;
      }
      container!.innerHTML = `
        <div class="flex flex-col items-center justify-center p-4 text-red-500">
           <p>⚠️ Error al cargar las notas.</p>
           <small class="text-gray-500 text-xs mt-1">${error.message}</small>
        </div>
      `;
    } finally {
      if (paginationContainer) paginationContainer.classList.remove("hidden");
    }
  };

  //FUNCIONES AUXILIARES

  if(formEdit) {
    formEdit.addEventListener("submit", async(event) =>{
      event.preventDefault();

      if(!currentEditingId) return;

      btnEdit.disabled = true;
      btnEdit.textContent = "Cargando...";
      errorMsg.classList.add("hidden");

      const formData = new FormData(formEdit);
      const data = Object.fromEntries(formData);
      const idNote = currentEditingId;
      
      try{
        await fetchDataPatch("notes", data, myToken!, idNote);

        const idx = notesData.findIndex(n => n.id === currentEditingId);
        if (idx !== -1) {
          notesData[idx] = { ...notesData[idx], ...data };
          notesData = sortNotesByDate(notesData);
          const newIndex = notesData.findIndex(n => n.id === currentEditingId);
          currentPage = Math.floor(newIndex / ITEMS_PER_PAGE) + 1;
        }

        // Re-render página actual
        renderPage(currentPage);

        modalEdit.classList.add("hidden");
        alert("Nota actualizada con éxito");
      } catch (error: any){
        errorMsg.textContent = error.message;
        errorMsg.classList.remove("hidden");
      } finally{
        btnEdit.disabled = false;
        btnEdit.textContent = "Editar nota";
      }
    });
  }

  let currentEditingId : any = null;

  const openEditModal = (id: string, cardEdit: HTMLElement) =>{
    currentEditingId = id;

    const title = cardEdit.querySelector(".note-title")?.textContent || "";
    const content = cardEdit.querySelector(".note-content")?.textContent || "";
    const category = cardEdit.querySelector(".category-pill")?.textContent || "";
    const issue = cardEdit.querySelector(".issue-pill")?.textContent || "";
    const status = cardEdit.querySelector(".status-badge")?.textContent || "";

    const titleInput = formEdit.elements.namedItem('title') as HTMLInputElement | null;
    const contentInput = formEdit.elements.namedItem('content') as HTMLTextAreaElement | null;
