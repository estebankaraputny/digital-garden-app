---
import "./notes.css";
---
  <div class="message-container hidden" id="message-container-note">
      <svg class="icon-check" id="icon-check-note" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M320 576C178.6 576 64 461.4 64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576zM320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320C528 205.1 434.9 112 320 112zM390.7 233.9C398.5 223.2 413.5 220.8 424.2 228.6C434.9 236.4 437.3 251.4 429.5 262.1L307.4 430.1C303.3 435.8 296.9 439.4 289.9 439.9C282.9 440.4 276 437.9 271.1 433L215.2 377.1C205.8 367.7 205.8 352.5 215.2 343.2C224.6 333.9 239.8 333.8 249.1 343.2L285.1 379.2L390.7 234z"/></svg>
      <p class="message-register" id="message-register-note"></p>
      <button class="button-message" id="message-btn-note"></button>
      <button class="button-close-message" id="close-message-btn-note"></button>
  </div>

  <section class="section-container-card">

    <div id="notes-container" class="notes-container">
      <p class="loading-text">Cargando tus notas...</p>
    </div>

    <div id="pagination-controls" class="pagination-container hidden">
      <button id="prev-page-btn" class="btn-pagination" disabled>⬅ Anterior</button>
        <span id="page-info">Página 1</span>
      <button id="next-page-btn" class="btn-pagination">Siguiente ➡</button>
    </div>

    <p id="no-notes-msg" class="hidden">No hay notas para mostrar.</p>

    <article class="modal-edit hidden" id="modal-edit">
    
      
      <form id="note-form-edit" class="form-edit">
        <h2>Editar nota</h2>
        <label for="title">
          <input
            type="text"
            name="title"
            id="title"
            placeholder="Titulo"
            required
          />
        </label>

        <label for="content">
          <textarea
            name="content"
            id="content"
            placeholder="Descripcion"
            required></textarea>
        </label>

        <label for="category">
          <select name="category" id="category" required class="category-edit">
            <option value="Criptomonedas y Web3">Criptomonedas y Web3</option>
            <option value="Ciberseguridad y Privacidad">Ciberseguridad y Privacidad</option>
            <option value="Crianza y Familia">Crianza y Familia</option>
            <option value="Desarrollo de Software y No-Code">Desarrollo de Software y No-Code</option>
            <option value="Desarrollo Personal y Liderazgo">Desarrollo Personal y Liderazgo</option>
            <option value="Emprendimiento y Startups">Emprendimiento y Startups</option>
            <option value="Fitness, Nutrición y Biohacking">Fitness, Nutrición y Biohacking</option>
            <option value="Finanzas Personales e Inversiones">Finanzas Personales e Inversiones</option>
            <option value="Idiomas y Aprendizaje Acelerado">Idiomas y Aprendizaje Acelerado</option>
            <option value="Inteligencia Artificial (IA) y Prompt Engineering">Inteligencia Artificial (IA) y Prompt Engineering</option>  
            <option value="Moda y Estilo Personal">Moda y Estilo Personal</option>
            <option value="Marketing Digital y Marca Personal">Marketing Digital y Marca Personal</option>
            <option value="Productividad y Gestión del Conocimiento">Productividad y Gestión del Conocimiento</option>
            <option value="Salud Mental y Psicología">Salud Mental y Psicología</option>
            <option value="Salud">Salud</option>
            <option value="Viajes y Nómadas Digitales">Viajes y Nómadas Digitales</option>
          </select>
        </label>

        <label for="issue">
          <input
            type="text"
            name="issue"
            id="issue"
            placeholder="Tema"
            required
          />
        </label>

        <label for="status">
          Estado
          <select name="status" id="status" required>
            <option value="Pendiente">Pendiente</option>
            <option value="En proceso">En Proceso</option>
            <option value="Terminado">Terminado</option>
          </select>
        </label>

        <div class="btn-content"> 

          <button type="submit" id="submit-edit-btn" class="btn-save"> Guardar</button>
          <button type="button" id="cancel-edit-btn" class="btn-cancel">Cancelar</button>
        </div>

        <p id="error-form-message-edit" class="error-text hidden"></p>
      </form>
    
    </article>
  </section>


<script>
  // 1. IMPORTANTE: Agrega la extensión del archivo (.ts o .js)
  // Si tus archivos en /lib/api son .ts, pon .ts. Si son .js, pon .js
  import fetchDataGetWithToken from "../../lib/api/fetchDataGetWithToken.ts";
  import { fetchDataPatch } from "../../lib/api/fetchDataPatch.ts";
  import fetchDataDelete from "../../lib/api/fetchDataDelete.ts";

  // --- VARIABLES ---
  let currentPage = 1;
  let totalPages = 1;
  let currentEditingId = null;
  const myToken = localStorage.getItem("token");

  // --- ELEMENTOS DOM ---
  const container = document.getElementById("notes-container");
  const noNotesMsg = document.getElementById("no-notes-msg");
  const paginationContainer = document.getElementById("pagination-controls");
  const prevBtn = document.getElementById("prev-page-btn");
  const nextBtn = document.getElementById("next-page-btn");
  const pageInfo = document.getElementById("page-info");
  
  // Modal elementos
  const modalEdit = document.getElementById("modal-edit");
  const formEdit = document.getElementById("note-form-edit");
  const btnEdit = document.getElementById("submit-edit-btn");
  const btnCancel = document.getElementById("cancel-edit-btn");
  const errorMsg = document.getElementById("error-form-message-edit");

  //Alert mensaje elementos
  const messageContainer = document.getElementById("message-container-note");
  const messageRegister = document.getElementById("message-register-note");
  const messageBtn = document.getElementById("message-btn-note");;
  const iconCheck = document.getElementById("icon-check-note");
  const buttonCloseMessageBtn = document.querySelector(".button-close-message");
  const fullPage = document.querySelector("body");


  // --- FUNCIONES AUXILIARES ---
  const timeAgo = (dateString) => {
    if (!dateString) return '';
    const date = new Date(dateString);
    const now = new Date();
    const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
    const rtf = new Intl.RelativeTimeFormat('es-AR', { numeric: 'auto' });

    if (diffInSeconds < 60) return rtf.format(-diffInSeconds, 'second');
    const diffInMinutes = Math.floor(diffInSeconds / 60);
    if (diffInMinutes < 60) return rtf.format(-diffInMinutes, 'minute');
    const diffInHours = Math.floor(diffInMinutes / 60);
    if (diffInHours < 24) return rtf.format(-diffInHours, 'hour');
    const diffInDays = Math.floor(diffInHours / 24);
    if (diffInDays < 30) return rtf.format(-diffInDays, 'day');
    return rtf.format(-Math.floor(diffInDays / 365), 'year');
  };

  const getStatusClass = (status) => {
      if (status === 'Terminado') return 'status-done';
      if (status === 'En proceso') return 'status-process';
      return 'status-pending';
  };

  const createNoteCard = (note) => {
    const authorName = note.author?.name || "Usuario";
    const initial = authorName.charAt(0).toUpperCase();
    const avatarUrl = note.author?.profile.avatar || initial;
    const CHAR_LIMIT = 120;
    const isLong = note.content.length > CHAR_LIMIT;
    
    let contentHTML = '';
    if (isLong) {
      const shortText = note.content.substring(0, CHAR_LIMIT) + "...";
      contentHTML = `
        <span class="short-text">${shortText}</span>
        <span class="full-text hidden">${note.content}</span>
        <button type="button" class="read-more-btn">Leer más</button>
      `;
    } else {
      contentHTML = `<span class="simple-text">${note.content}</span>`;
    }
    
    console.log("Creando tarjeta para la nota:", note);

    return `
      <article class="note-card" id="${note.id}">
        <div class="card-header">
            <div class="user-info">
                <div>
                  <img  class="avatar-circle" src="${avatarUrl}" alt="Avatar de ${authorName}" class="avatar-image"/>
                </div>
                <div class="user-meta">
                    <span class="user-name">${authorName}</span>
                    <div class="post-meta">
                        <time>${timeAgo(note.createdAt)}</time>
                        <span>•</span>
                        <span class="status-badge ${getStatusClass(note.status)}">${note.status || 'Borrador'}</span>
                    </div>
                </div>
            </div>
            <div class="card-actions-wrapper">
              <button class="menu-trigger-card">
                <svg class="points-options" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 208C289.1 208 264 182.9 264 152C264 121.1 289.1 96 320 96C350.9 96 376 121.1 376 152C376 182.9 350.9 208 320 208zM320 432C350.9 432 376 457.1 376 488C376 518.9 350.9 544 320 544C289.1 544 264 518.9 264 488C264 457.1 289.1 432 320 432zM376 320C376 350.9 350.9 376 320 376C289.1 376 264 350.9 264 320C264 289.1 289.1 264 320 264C350.9 264 376 289.1 376 320z"/></svg>
              </button>
              <div class="menu-dropdown hidden">
                <button class="edit-btn menu-item" data-id="${note.id}" type="button">Editar</button>
                <button class="delete-btn menu-item" data-id="${note.id}" type="button">Eliminar</button>
              </div>
            </div>
        </div>
        <div class="note-body">
          <h2 class="note-title">${note.title}</h2>
          <div class="note-content-wrapper">${contentHTML}</div>
        </div>
        <div class="note-footer">
            <div class="badges-container">
                <span class="pill-badge category-pill">${note.category || 'General'}</span>
                ${note.issue ? `<span class="pill-badge issue-pill">#${note.issue}</span>` : ''}
            </div>
        </div>
      </article>
    `;
  };

  // --- CARGA DE NOTAS ---
  const loadNotes = async (page = 1) => {
    if (!myToken) {
      window.location.href = "/login";
      return;
    }

    if (container) container.style.opacity = "0.5";

    try {
      // 2. CORRECCIÓN: Asegurar que la ruta sea correcta
      const response = await fetchDataGetWithToken(`notes/user-notes?page=${page}`, myToken);
      
      const notesData = response.data || response; 
      const metaData = response.meta || { page: 1, lastPage: 1 };

      if (!notesData || notesData.length === 0) {
        if (container) container.innerHTML = ""; 
        if (noNotesMsg) noNotesMsg.classList.remove("hidden");
        if (paginationContainer) paginationContainer.classList.add("hidden");
        return;
      }

      if (noNotesMsg) noNotesMsg.classList.add("hidden");
      if (container) container.innerHTML = notesData.map((note) => createNoteCard(note)).join("");

      currentPage = metaData.page;
      totalPages = metaData.lastPage;
      
      updatePaginationUI();
      activateEditButton();
      activateDeleteButtons();
      activateMenus();
      activateReadMoreButtons();

    } catch (error) {
      console.error("Error detallado:", error);
      
      function bloquearNavegacion() {
        document.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'PageUp' || e.key === 'PageDown' || e.key === ' ' || e.key === 'Home' || e.key === 'End') {
            e.preventDefault();
          }
        });

        document.addEventListener('wheel', function(e) { e.preventDefault(); }, { passive: false });
        document.addEventListener('touchmove', function(e) { e.preventDefault(); }, { passive: false });
        document.addEventListener('mousedown', function(e) { e.preventDefault(); }); // Para evitar clics arrastrando
      }

      // 3. MANEJO AUTOMÁTICO DE ERROR 401 (TOKEN EXPIRADO)
      if (error.status === 401 || (error.message && error.message.includes('401'))) {

          bloquearNavegacion();
          iconCheck?.classList.add("hidden");
          buttonCloseMessageBtn?.classList.add("hidden");
          messageContainer.classList.remove("hidden");
          messageRegister.textContent = "Sesión expirada. Por favor ingresa nuevamente.";
          messageBtn.textContent = "Volver a iniciar sesión";
          messageBtn?.addEventListener("click", () => {
              messageContainer.classList.add("hidden");
              localStorage.removeItem("token");
              document.location.href = "/login";
          });
          return;
      }
      if (container) container.innerHTML = `<p class="error-msg">Error al cargar notas.</p>`;
    } finally {
       if (container) container.style.opacity = "1";
    }
  };

  // --- UI UPDATES & LISTENERS ---
  const updatePaginationUI = () => {
    if (!paginationContainer || !pageInfo) return;
    paginationContainer.classList.toggle("hidden", totalPages <= 1);
    pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
    if(prevBtn) prevBtn.disabled = currentPage <= 1;
    if(nextBtn) nextBtn.disabled = currentPage >= totalPages;
  };
  
  const activateReadMoreButtons = () => {
    document.querySelectorAll('.read-more-btn').forEach(btn => {
      btn.onclick = (e) => {
        const wrapper = e.target.closest('.note-content-wrapper');
        const shortText = wrapper.querySelector('.short-text');
        const fullText = wrapper.querySelector('.full-text');
        if (shortText.classList.contains('hidden')) {
          shortText.classList.remove('hidden');
          fullText.classList.add('hidden');
          e.target.textContent = "Leer más";
        } else {
          shortText.classList.add('hidden');
          fullText.classList.remove('hidden');
          e.target.textContent = "Leer menos";
        }
      };
    });
  };

  // Event Listeners Paginación
  if (prevBtn) prevBtn.addEventListener("click", () => { if (currentPage > 1) loadNotes(currentPage - 1); });
  if (nextBtn) nextBtn.addEventListener("click", () => { if (currentPage < totalPages) loadNotes(currentPage + 1); });

  // Event Listeners Modal Edit
  const openEditModal = (id, cardEdit) => {
    currentEditingId = id;
    const title = cardEdit.querySelector(".note-title")?.textContent;
    const fullTextEl = cardEdit.querySelector(".full-text");
    const simpleTextEl = cardEdit.querySelector(".simple-text");
    const content = fullTextEl ? fullTextEl.textContent : (simpleTextEl ? simpleTextEl.textContent : "");
    const category = cardEdit.querySelector(".category-pill")?.textContent;
    const issue = cardEdit.querySelector(".issue-pill")?.textContent?.replace("#", "") || "";
    const status = cardEdit.querySelector(".status-badge")?.textContent.trim();

    formEdit.title.value = title;
    formEdit.content.value = content;
    formEdit.category.value = category;
    formEdit.issue.value = issue;
    formEdit.status.value = status;
  
    modalEdit.classList.remove("hidden");
    cardEdit.querySelector(".menu-dropdown")?.classList.add("hidden");
  };

  const activateEditButton = () => {
    document.querySelectorAll(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        openEditModal(e.currentTarget.dataset.id, e.currentTarget.closest(".note-card"));
      });
    });
  };

  const activateDeleteButtons = () => {
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const noteId = e.currentTarget?.dataset?.id;
        if (!noteId) {
          console.error("No se encontró el ID de la nota");
          return;
        }
        
        messageContainer.classList.remove("hidden");
        iconCheck?.classList.add("hidden");
        messageRegister.textContent = "¿Estas seguro que deseas eliminar esta nota?";
        messageBtn.textContent = "Aceptar";
        buttonCloseMessageBtn.textContent = "Cancelar";
        
        messageBtn?.addEventListener("click", async () => {
          messageContainer.classList.add("hidden");
          try {
            await fetchDataDelete(`notes/${noteId}`, myToken);
              messageContainer.classList.remove("hidden");
              iconCheck?.classList.remove("hidden");
              iconCheck.style.marginTop = "10px";
              messageRegister.textContent = "Nota eliminada con éxito";
              buttonCloseMessageBtn.textContent = "Cerrar";
              messageBtn.classList.add("hidden");
              buttonCloseMessageBtn.addEventListener("click", () => { 
              messageContainer.classList.add("hidden"); 
              loadNotes(currentPage);
            });
          } catch (error) { 
              buttonCloseMessageBtn.classList.add("hidden");
              messageContainer.classList.remove("hidden");
              messageRegister.textContent = "Error al eliminar la nota";
              messageBtn.textContent = "Cerrar";
              console.error("Error al eliminar la nota:", error);
              messageBtn.addEventListener("click", () => { 
                messageContainer.classList.add("hidden"); 
              });
           }
        });
        
        buttonCloseMessageBtn?.addEventListener("click", () => { 
          messageContainer.classList.add("hidden");
        });
      });
    });
  };

  const activateMenus = () => {
    document.querySelectorAll('.menu-trigger-card').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const dropdown = trigger.nextElementSibling;
            document.querySelectorAll('.menu-dropdown').forEach(m => m !== dropdown && m.classList.add('hidden'));
            dropdown?.classList.toggle('hidden');
        });
    });
  };

  if(formEdit) {
    formEdit.addEventListener("submit", async(e) => {
      e.preventDefault();
      if(!currentEditingId) return;
      btnEdit.disabled = true; btnEdit.textContent = "Guardando...";
      const data = Object.fromEntries(new FormData(formEdit));
      try {
        await fetchDataPatch("notes", data, myToken, currentEditingId);
        loadNotes(currentPage);
        modalEdit.classList.add("hidden");
      } catch (err) {
        errorMsg.textContent = err.message; errorMsg.classList.remove("hidden");
      } finally { btnEdit.disabled = false; btnEdit.textContent = "Guardar"; }
    });
  }

  if(btnCancel) btnCancel.onclick = () => { modalEdit.classList.add("hidden"); };

  // Clicks globales
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.card-actions-wrapper')) {
        document.querySelectorAll('.menu-dropdown').forEach(menu => menu.classList.add('hidden'));
    }
    if (e.target === modalEdit) modalEdit.classList.add('hidden');
  });

  // INICIO
  loadNotes(1);
</script>


<!-- 
<script>
  // Importamos las funciones necesarias
  import fetchDataGetWithToken from "../../lib/api/fetchDataGetWithToken";
  import fetchDataPatch from "../../lib/api/fetchDataPatch";
  import fetchDataDelete from "../../lib/api/fetchDataDelete";


  // ---LÓGICA DE DATOS ---
  const container = document.getElementById("notes-container");
  const noNotesMsg = document.getElementById("no-notes-msg");
  const myToken = localStorage.getItem("token");
  const modalEdit = document.getElementById("modal-edit") as HTMLElement;
  const formEdit = document.getElementById("note-form-edit") as HTMLFormElement;
  const btnEdit = document.getElementById("submit-edit-btn") as HTMLButtonElement;
  const btnCancel = document.getElementById("cancel-edit-btn") as HTMLButtonElement;
  const errorMsg = document.getElementById("error-form-message-edit") as HTMLParagraphElement;

  // --- PAGINACIÓN ---
  const paginationContainer = document.getElementById("pagination-controls") as HTMLDivElement;
  const prevBtn = document.getElementById("prev-page-btn") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-page-btn") as HTMLButtonElement;
  const pageInfo = document.getElementById("page-info") as HTMLSpanElement;

  const ITEMS_PER_PAGE = 6; // ajustar si se quiere otro tamaño
  let currentPage = 1;
  let totalPages = 1;
  let notesData: any[] = [];

//ORDENAR
const sortNotesByDate = (notes : any[]) => {
    // Creamos una copia con slice() para no mutar el original inesperadamente
    return notes.slice().sort((a, b) => {
      // Orden Descendente: El más nuevo (fecha mayor) primero
      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
    });
  };

  // Función para generar el HTML de una tarjeta
  const createNoteCard = (note : any) => {

    const authorName = note.author?.name || "Usuario";
    const initial = authorName.charAt(0).toUpperCase();
  
    return `
      <article class="note-card" id="${note.id}">
        <div class="card-header">

        <div class="user-info">
                <div class="avatar-circle">${initial}</div>
                <div class="user-meta">
                    <span class="user-name">${authorName}</span>
                    <div class="post-meta">
                        <time datetime="${note.createdAt}">${timeAgo(note.createdAt)}</time>
                        <span>•</span>
                        <span class="status-badge ${note.status === 'Terminado' ? 'status-done' : note.status === 'En proceso' ? 'status-process' : 'status-pending'}">
                           ${note.status || 'Borrador'}
                        </span>
                    </div>
                </div>
        </div>


            <div class="card-actions-wrapper">
              <button class="menu-trigger-card">
                <svg class="points-options" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 208C289.1 208 264 182.9 264 152C264 121.1 289.1 96 320 96C350.9 96 376 121.1 376 152C376 182.9 350.9 208 320 208zM320 432C350.9 432 376 457.1 376 488C376 518.9 350.9 544 320 544C289.1 544 264 518.9 264 488C264 457.1 289.1 432 320 432zM376 320C376 350.9 350.9 376 320 376C289.1 376 264 350.9 264 320C264 289.1 289.1 264 320 264C350.9 264 376 289.1 376 320z"/></svg>
              </button>

              <div class="menu-dropdown hidden">
                <button class="edit-btn menu-item" data-id="${note.id}" type="button" title="Editar nota"> Editar </button>
                <button class="delete-btn menu-item" data-id="${note.id}" type="button" title="Eliminar nota">
                  Eliminar
                </button>
                <button class="menu-item" type="button" title="Compartir">Compartir</button>
              </div>
              </div>

        </div>
        <div class="note-body">
          <h2 class="note-title">${note.title}</h2>
          <p class="note-content">${note.content}</p>
        </div>
        

        <div class="note-footer">
            <div class="badges-container">
                <span class="pill-badge category-pill">${note.category || 'General'}</span>
                ${note.issue ? `<span class="pill-badge issue-pill">#${note.issue}</span>` : ''}
            </div>
        </div>
      </article>
      
    `;
  };

  const updatePaginationControls = () => {
    totalPages = Math.max(1, Math.ceil(notesData.length / ITEMS_PER_PAGE));
    if (!paginationContainer || !pageInfo || !prevBtn || !nextBtn) return;

    if (notesData.length <= ITEMS_PER_PAGE) {
      paginationContainer.classList.add("hidden");
    } else {
      paginationContainer.classList.remove("hidden");
    }

    pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
  };

  const renderPage = (page = 1) => {
    if (!container || !noNotesMsg) return;

    if (notesData.length === 0) {
      container.innerHTML = "";
      noNotesMsg.classList.remove("hidden");
      if (paginationContainer) paginationContainer.classList.add("hidden");
      return;
    }

    noNotesMsg.classList.add("hidden");
    totalPages = Math.ceil(notesData.length / ITEMS_PER_PAGE);
    currentPage = Math.min(Math.max(1, page), totalPages);

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;
    const pageNotes = notesData.slice(start, end);

    container.innerHTML = pageNotes.map((note) => createNoteCard(note)).join("");

    updatePaginationControls();

    // Re-activar handlers para los elementos recién renderizados
    activateEditButton();
    activateDeleteButtons();
    activateMenus();
  };

  if (prevBtn) prevBtn.addEventListener("click", () => { if (currentPage > 1) renderPage(currentPage - 1); });
  if (nextBtn) nextBtn.addEventListener("click", () => { if (currentPage < totalPages) renderPage(currentPage + 1); });

  const loadNotes = async () => {
    if (!myToken) {
      window.location.href = "/login";
      return;
    }

    try {
      // Fetch al backend
      const userNotes = await fetchDataGetWithToken("notes/user-notes", myToken);

      if (!userNotes || userNotes.length === 0) {
        container!.innerHTML = ""; 
        noNotesMsg!.classList.remove("hidden");
        return;
      }

      const sortedNotes = sortNotesByDate(userNotes);

      notesData = sortedNotes;
      totalPages = Math.ceil(notesData.length / ITEMS_PER_PAGE);
      currentPage = 1;
      renderPage(1);


    } catch (error: any) {
      console.error("Error:", error);if (error.message.includes("401") || error.message.toLowerCase().includes("unauthorized")) {
         alert("La sesión expiró. Por favor, ingresa nuevamente.");
         localStorage.removeItem("token");
         window.location.href = "/login";
         return;
      }
      container!.innerHTML = `
        <div class="flex flex-col items-center justify-center p-4 text-red-500">
           <p>⚠️ Error al cargar las notas.</p>
           <small class="text-gray-500 text-xs mt-1">${error.message}</small>
        </div>
      `;
    } finally {
      if (paginationContainer) paginationContainer.classList.remove("hidden");
    }
  };

  //FUNCIONES AUXILIARES

  if(formEdit) {
    formEdit.addEventListener("submit", async(event) =>{
      event.preventDefault();

      if(!currentEditingId) return;

      btnEdit.disabled = true;
      btnEdit.textContent = "Cargando...";
      errorMsg.classList.add("hidden");

      const formData = new FormData(formEdit);
      const data = Object.fromEntries(formData);
      const idNote = currentEditingId;
      
      try{
        await fetchDataPatch("notes", data, myToken!, idNote);

        const idx = notesData.findIndex(n => n.id === currentEditingId);
        if (idx !== -1) {
          notesData[idx] = { ...notesData[idx], ...data };
          notesData = sortNotesByDate(notesData);
          const newIndex = notesData.findIndex(n => n.id === currentEditingId);
          currentPage = Math.floor(newIndex / ITEMS_PER_PAGE) + 1;
        }

        // Re-render página actual
        renderPage(currentPage);

        modalEdit.classList.add("hidden");
        alert("Nota actualizada con éxito");
      } catch (error: any){
        errorMsg.textContent = error.message;
        errorMsg.classList.remove("hidden");
      } finally{
        btnEdit.disabled = false;
        btnEdit.textContent = "Editar nota";
      }
    });
  }

  let currentEditingId : any = null;

  const openEditModal = (id: string, cardEdit: HTMLElement) =>{
    currentEditingId = id;

    const title = cardEdit.querySelector(".note-title")?.textContent || "";
    const content = cardEdit.querySelector(".note-content")?.textContent || "";
    const category = cardEdit.querySelector(".category-pill")?.textContent || "";
    const issue = cardEdit.querySelector(".issue-pill")?.textContent || "";
    const status = cardEdit.querySelector(".status-badge")?.textContent || "";

    const titleInput = formEdit.elements.namedItem('title') as HTMLInputElement | null;
    const contentInput = formEdit.elements.namedItem('content') as HTMLTextAreaElement | null;
    const categorySelect = formEdit.elements.namedItem('category') as HTMLSelectElement | null;
    const issueInput = formEdit.elements.namedItem('issue') as HTMLInputElement | null;
    const statusSelect = formEdit.elements.namedItem('status') as HTMLSelectElement | null;

    if (titleInput) titleInput.value = title.replace(/^\s+|\s+$/g, '').replace(/^#/, '');
    if (contentInput) contentInput.value = content;
    if (categorySelect) categorySelect.value = category;
    if (issueInput) issueInput.value = issue.replace(/^#/, '');
    if (statusSelect) statusSelect.value = status;

  
    modalEdit.classList.remove("hidden");

    const menu = cardEdit.querySelector(".menu-dropdown");
    if (menu) menu.classList.add("hidden");

  };

  //Función para editar

  const activateEditButton = () => {
    const buttons = document.querySelectorAll(".edit-btn");

    buttons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.stopPropagation();


        const target = event.currentTarget as HTMLButtonElement;
        const idNote : any = target.dataset.id;


        const card : any = target.closest(".note-card");

        openEditModal(idNote, card);
      });
