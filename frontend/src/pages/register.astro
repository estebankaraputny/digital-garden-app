                                </button>
                            
                            </div>
                        </div>
                        <p class="error-message hidden"></p>
                        <button type="submit" class="btn-register-form btn-register">
                            Registrarme
                        </button>
    
                        <div class="form-footer">
                            <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
                            </div>
                    </form>
                </div>
            </aside>
        </section>

        
     </section>
    <!-- </main> -->

</Layout>

<script>
    import {fetchDataPost} from "../lib/api/fetchDataPost";
    // Seleccionamos el formulario
    const form = document.querySelector('.modern-form') as HTMLFormElement;
    const btn = document.querySelector('.btn-register-form') as HTMLButtonElement;
    // Elemento para mostrar errores
    const errorMsg = document.querySelector('.error-message');
    //VER CONTRA
    const passInput = document.getElementById('password') as HTMLInputElement;
    const toggleBtn = document.getElementById('toggle-password-btn') as HTMLButtonElement;
    const eyeInClosed = document.getElementById('eye-in-closed');
    const eyeInOpen = document.getElementById('eye-in-open');

    //Funcion ver contra
    toggleBtn.addEventListener('click', () => {
        const isPassword = passInput.type === 'password';
        passInput.type = isPassword ? 'text' : 'password';

        if(isPassword){
            eyeInClosed?.classList.add('hidden');
            eyeInOpen?.classList.remove('hidden');
        }else{
            eyeInClosed?.classList.remove('hidden');
            eyeInOpen?.classList.add('hidden');
        }
    })



    if (form) {
        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Procesando...';
            }

            // 2. Capturar los datos AUTOMÁTICAMENTE
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            const messageContainer = document.getElementById('message-container') as HTMLDivElement;
            const messageRegister = document.getElementById('message-register') as HTMLParagraphElement;
            const buttonMessage = document.getElementById('button-message') as HTMLButtonElement;
            // console.log("Enviamos a back", data);

            try {
                
                const response = await fetchDataPost('auth/register', data);
            
                if (response && (response.id || response.access_token || response.email)) {
                    messageContainer.classList.remove('hidden');
                    messageRegister.textContent = '¡Cuenta creada con éxito!';
                    buttonMessage.addEventListener('click', () => {
                        messageContainer.classList.add('hidden');
                        messageRegister.textContent = '';
                        window.location.href = '/login';
                    });
                } else {
                    messageContainer.classList.remove('hidden');
                    messageRegister.textContent =  'Hubo un problema al crear la cuenta. Inténtalo de nuevo.';
                    buttonMessage.addEventListener('click', () => {
                        messageContainer.classList.add('hidden');
                        messageRegister.textContent = '';
                    });

                    throw new Error('No se pudo crear la cuenta.');
                }

            } catch (error: any) {
                if (errorMsg) errorMsg.textContent = error;
                if (errorMsg) errorMsg.classList.remove('hidden');
            } finally {
                // Restaurar botón
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Registrarme';
                }
            }
        });
    }
</script>


