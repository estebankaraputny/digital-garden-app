                <svg id="eye-in-open" class="hidden"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M320 144C254.8 144 201.2 173.6 160.1 211.7C121.6 247.5 95 290 81.4 320C95 350 121.6 392.5 160.1 428.3C201.2 466.4 254.8 496 320 496C385.2 496 438.8 466.4 479.9 428.3C518.4 392.5 545 350 558.6 320C545 290 518.4 247.5 479.9 211.7C438.8 173.6 385.2 144 320 144zM127.4 176.6C174.5 132.8 239.2 96 320 96C400.8 96 465.5 132.8 512.6 176.6C559.4 220.1 590.7 272 605.6 307.7C608.9 315.6 608.9 324.4 605.6 332.3C590.7 368 559.4 420 512.6 463.4C465.5 507.1 400.8 544 320 544C239.2 544 174.5 507.2 127.4 463.4C80.6 419.9 49.3 368 34.4 332.3C31.1 324.4 31.1 315.6 34.4 307.7C49.3 272 80.6 220 127.4 176.6zM320 400C364.2 400 400 364.2 400 320C400 290.4 383.9 264.5 360 250.7C358.6 310.4 310.4 358.6 250.7 360C264.5 383.9 290.4 400 320 400zM240.4 311.6C242.9 311.9 245.4 312 248 312C283.3 312 312 283.3 312 248C312 245.4 311.8 242.9 311.6 240.4C274.2 244.3 244.4 274.1 240.5 311.5zM286 196.6C296.8 193.6 308.2 192.1 319.9 192.1C328.7 192.1 337.4 193 345.7 194.7C346 194.8 346.2 194.8 346.5 194.9C404.4 207.1 447.9 258.6 447.9 320.1C447.9 390.8 390.6 448.1 319.9 448.1C258.3 448.1 206.9 404.6 194.7 346.7C192.9 338.1 191.9 329.2 191.9 320.1C191.9 309.1 193.3 298.3 195.9 288.1C196.1 287.4 196.2 286.8 196.4 286.2C208.3 242.8 242.5 208.6 285.9 196.7z"/></svg>
            </button>
          </div>
        </label>
        
        <button type="submit" id="submit-btn" class="button-login">
          Ingresar
        </button>

        <div class="form-footer">
          <p>¿No tienes una cuenta? <a href="./register">Crear una</a></p>
        </div>
        <p id="error-message" class="hidden error-text"></p>
      </form>
    </section>
  </main>
</Layout>

<script>
  import fetchDataPost from "../lib/api/fetchDataPost";

  //DOM
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message') as HTMLParagraphElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  /**VER CONTRA */
  const passInput = document.getElementById('password-input') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-password-btn');
  const eyeClosed = document.getElementById('eye-in-closed');
  const eyeOpen = document.getElementById('eye-in-open');

  //ver contraseña
  toggleBtn?.addEventListener('click', () => {
    const isPassword = passInput.type === 'password';
    passInput.type = isPassword ? 'text' : 'password';

    if (isPassword) {
      eyeOpen?.classList.remove('hidden');
      eyeClosed?.classList.add('hidden');
    } else {
      eyeOpen?.classList.add('hidden');
      eyeClosed?.classList.remove('hidden');
    }
  });
  
  //submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    errorMsg.textContent = '';
    errorMsg.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Cargando...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      //Llamada al Backend
      const response = await fetchDataPost('auth/login', data);
      console.log('Respuesta:', response);

      if (response.access_token) {
        // Guardar Token y si es admin
        localStorage.setItem('token', response.access_token);
        localStorage.setItem('isAdmin', 'true');
        
        // Redireccionar
        window.location.href = '/user/dashboard'; // O la página que quieras
      } else {
        throw new Error('No se recibió el token');
      }

    } catch (error: any) {
      console.error(error);
      console.log(error);
      // UI: Mostrar error
      errorMsg.textContent = error.message;
      errorMsg.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Ingresar';
    }
  });

</script>

<style>
  .login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh; /* Centrado vertical */
    font-family: 'Figtree', system-ui, sans-serif;
    padding: 1rem;
    background-color: var(--primary-color); /* O var(--background-color) si prefieres el beige de fondo */
  }
  
  section {
    background: var(--white-color);
    padding: 3rem 2.5rem;
    border-radius: 16px; /* Bordes más suaves */
    width: 100%;
    max-width: 420px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08); /* Sombra moderna y difusa */
    border: 1px solid var(--border-color);
  }

  h1 {
    text-align: center;
    color: var(--tertidary-color); /* Verde oscuro */
    margin-bottom: 2rem;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  label {
    display: flex;
    flex-direction: column;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    gap: 0.5rem;
  }

  input {
    padding: 0.85rem 1rem;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 1rem;
    background-color: #fafafa;
    transition: all 0.2s ease;
    outline: none;
  }
  input:focus {
    background-color: var(--white-color);
    border-color: var(--secondary-color); 
    box-shadow: 0 0 0 4px rgba(68, 125, 75, 0.1);
  }

  /**VER CONTRA */

  .password-wrapper {
  position: relative; 
    display: flex;
    align-items: center;
    width: 100%;
}
  .password-wrapper input {
    width: 100%;
    padding: 0.8rem;
    padding-right: 3rem;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .toggle-password-btn {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%); 
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10; 
    color: #333; 
    width: 40px; 
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-password-btn:hover {
    color: #000;
    background-color: rgba(0,0,0,0.05)
    border-radius: 50%;
  }

  .toggle-password-btn svg{
    width: 20px;
    height: 20px;
    overflow: visible;
  }
  .button-login {
    background-color: var(--secondary-color);
    color: var(--white-color);
    padding: 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    font-size: 1rem;
    margin-top: 1rem;
    transition: all 0.2s ease;
    box-shadow: 0 4px 6px rgba(68, 125, 75, 0.2);
  }

  .button-login:hover {
    background-color: var(--tertiary-color);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(68, 125, 75, 0.3);
  }

  .button-login:active {
    transform: translateY(0);
  }

  .button-login:disabled {
    background-color: var(--color-text-secondary);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .form-footer {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.9rem;
        color: var(--color-text-light);
    }

    .form-footer a {
        color: var(--secondary-color);
        text-decoration: none;
        font-weight: 600;
    }

    .form-footer a:hover {
        text-decoration: underline;
    }

  /* Estilos para el mensaje de error */
  .error-text {
    background-color: #fef2f2;
    color: #dc2626;
    font-size: 0.875rem;
    text-align: center;
    padding: 0.75rem;
    border-radius: 6px;
    border: 1px solid #fecaca;
    margin-top: 0.5rem;
    animation: shake 0.4s ease-in-out;
  }

  .hidden {
    display: none;
  }

  /* Animación de error */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }

  /* Responsive para móviles */
  @media (max-width: 480px) {
    section {
        padding: 2rem 1.5rem;
        box-shadow: none;
        border: none;
        background: transparent;
    }
    
    .login-container {
        align-items: flex-start;
        padding-top: 2rem;
    }

    input {
        font-size: 16px;
    }
  }
</style>