---
import Layout from "../layouts/Layout.astro"
---

<Layout title="login">
  <main class="login-container">
    <section>
      <h1>Iniciar Sesión</h1>
      
      <form id="login-form">
        <label>
          Correo electrónico
          <input type="email" name="email" placeholder="admin@digitalgarden.com" required>
        </label>
        
        <label>
          Contraseña
          <div class="password-wrapper">
            <input type="password" name="password" id="password-input" required>

            <button class="toggle-password-btn" type="button" id="toggle-password-btn" aria-label="Mostrar constraseña">
