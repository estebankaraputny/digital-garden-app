    width: 20%;
    border-radius: 8px;
    height: fit-content;
  }
  h2 {
    font-size: 1.5rem;
  }
  .list-category{
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin-top: 1rem;
  }
  .filter-btn {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0;
    text-align: left;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    color: var(--secondary-color); 
  }
  .filter-btn.active {
    color: var(--secondary-color);
    font-weight: bold;
    text-decoration: underline;
  }
  .aside-notes{
    width: 75%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .content-search{
        display: flex;
        align-items: center;
        gap: .5rem;
