        border: 1px solid #ccc;
  }
  .container-notes{
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .note-card {
    flex-basis: calc(50% - 1rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--white-color);
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: 8px;
    /* Animación suave al aparecer */
    animation: fadeIn 0.5s ease-in-out;
    gap: .5rem;
  }

   /* Clase para ocultar elementos */
  .hidden {
    display: none !important;
  }
  .note-category{
    font-size: .8rem;
    color: var(--color-text-light);
    font-weight: 600;
    /* text-align: end; */
  }
  .note-title{
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text-secondary);

  }
  .note-content{
        flex-grow: 1;
        margin: .5rem 0;
        color: var(--color-text-primary);
  }
  .note-footer{
        display: flex;
        justify-content: space-between;
        align-items: center;
  }
  .note-date{
        font-size: .8rem;
        color: var(--color-text-light);
  }
  .btn-view-note {
        padding: .5rem;
        background-color: var(--secondary-color); /* Ajusta a tu paleta */
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
        transition: background 0.3s ease;
  }
  .btn-view-note:hover {
        background-color: var(--tertidary-color);
  }

  /**SECCION CREAR CUENTA */
  .section-add{
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 2rem;
      width: 100%;
      text-align: center;
      color: var(--white-color);
      background-image: url(../assets/image/fondo-sectin-one.png);
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.418);
  }  
  .section-add div{
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      padding-top: 9rem;
      padding-bottom: 9rem ;
  }

  .section-add h2{
      font-size: 2rem;
      font-weight: 600;
      color: var(--white-color);
  }

  .section-add p{
      font-size: 1.2rem;
      color: var(--white-color);
  }
  .section-add button{
      padding: 1rem 4rem;
