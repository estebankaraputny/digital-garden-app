---
import Layout from "../layouts/Layout.astro";
import fetchDataGet from "../lib/api/fetchDataGet";

let notes = [];
let categories: any = [];

try {
  notes = await fetchDataGet("notes");

  if (notes && notes.length > 0) {
    notes.sort((a: any, b: any) => 
      new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
    );
  }

  if (notes && notes.length > 0) {
        const categorySet = new Set();
        notes.forEach((note: any) => {
            if (note.category) {
                categorySet.add(note.category);
            }
        });
        categories = Array.from(categorySet);
    }

} catch (error) {
  console.error("Error cargando notas:", error);
}

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("es-AR", {
    weekday: "long", year: "numeric", month: "long", day: "numeric",
  });
};


const ITEMS_PER_PAGE = 6;

---

<Layout title="Digital Garden - Home">
  <main class="container-home">
    <section class="section-one">
      <h1>Digital <span>Garden</span></h1>
      <p>Encuentra notas de los temas que te interesan.</p>
      <p>Algunas notas estan creadas con IA. Realizamos busquedas para realizar notas lo más correctas posibles.</p>
    </section>
    <section class="content-asides">
      <aside class="aside-category">
        <h2>Categorías</h2>
        <div class="content-list-category">
          <ul class="list-category">
            <li>
              <button class="filter-btn active" id="all">
                Todas
              </button>
            </li>
            {
              categories.map((category: string) => {
                  return (
                      <li class="content-link-category">
                          <button class="filter-btn" id={category.toLocaleLowerCase()}>{category}</a>
                      </li>
                  )
              })
            }
          </ul>
        </div>
      </aside>
      <aside class="aside-notes">
          <h2>Últimas notas</h2>
        <div class="content-search">
            <label for="">
                <i class="fa-light fa-magnifying-glass"></i>
            <input type="search" name="" id="" placeholder="Hooks de React">
        </div>
        <div id="notes-container" class="container-notes">
          {
            notes.map((note: any, index: number) => (
              <article 
                class={`note-card ${index >= ITEMS_PER_PAGE ? 'hidden' : ''}`} 
                id={note.id}
                data-category={note.category}
              >
                <div>
                  <p class="note-category">{note.category}</p>
                </div>
                <h2 class="note-title">{note.title}</h2>

                <div class="note-content">
                  <p>{note.content.slice(0, 50)}...</p>         
                </div>
                <div class="note-footer">
                    <div>
                        <button class="btn-view-note" id={note.id}>Leer nota completa</button>
                    </div>
                    <time class="note-date" datetime={note.createdAt} class="date">
                    {formatDate(note.createdAt)}
                    </time>
                </div>
              </article>
            ))
          }
        </div>
          {notes.length === 0 && <p>No hay notas para mostrar.</p>}
          {notes.length > ITEMS_PER_PAGE && (
            <div class="pagination-container">
              <button id="load-more-btn">Cargar más notas</button>
            </div>
          )}


      </aside>
    </section>
    <section class="section-add">
      <div>
        <h2>¿Queres crear notas?</h2>
        <p>Envia tu postulación en el siguiente formulario.</p>
        <button onclick="window.location.href='/apply-author'">Postularme</button>
      </div>
    </section>
    <section class="section-theme">
      <div>
        <h2>¿No encontraste lo que buscabas?</h2>
        <p>Envianos tus sugerencias o temas de interés y los agregaremos a nuestro jardín digital.</p>
        <button onclick="window.location.href='/suggest-topic'">Sugerir tema</button>
      </div>
    </section>
    <section class="section-aboutme">
      <div>
        <h2>Tus pensamientos y saberes son valiosos para otros.</h2>
        <p>Comparte tus conocimientos creando y publicando tus propias notas en nuestro jardín digital.</p>
        <button onclick="window.location.href='/create-note'">Crear nota</button>
      </div>
    </section>
  </main>
</Layout>

<script>

  const loadMoreBtn = document.getElementById('load-more-btn');
  const buttons = document.querySelectorAll('.btn-view-note');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const allCards = document.querySelectorAll('.note-card');
  const ITEMS_PER_PAGE = 6;

  
buttons.forEach((button) => {
        
    button.addEventListener('click', (event) => {
        const currentBtn = event.currentTarget as HTMLButtonElement;
        const idNote = currentBtn.id;

        if (idNote) {
                console.log('ID de la nota:', idNote);
                
                // B. Guardamos en LocalStorage
                localStorage.setItem('noteId', idNote);
                
                // C. Redirigimos
                window.location.href = '/details-note';
            }
            else {
                console.error('No se encontró el ID de la nota.');
            }
    });
});


/**FILTROS DE CATEGORIAS */    

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();

        filterButtons.forEach(b => b.classList.remove('active'));
        (e.target as HTMLElement).classList.add('active');

        const selectedCat = (e.target as HTMLElement).id;
        console.log("Filtrando por:", selectedCat);

        if (loadMoreBtn) {
            if (selectedCat === 'all') {
                loadMoreBtn.style.display = 'block'; 
            } else {
                loadMoreBtn.style.display = 'none';
            }
        }

        allCards.forEach(card => {
          const cardElement = card as HTMLElement;
          const cardCat = cardElement.dataset.category?.toLowerCase();

          if (selectedCat === 'all') {
            cardElement.classList.remove('hidden');
          } else {
            if (cardCat === selectedCat) {
              cardElement.classList.remove('hidden');
            } else {
              cardElement.classList.add('hidden');
            }
          }
        });
      });
    });

    

</script>

<style>
