    background-color: var(--secondary-color);
    opacity: 0.4;
    z-index: -1;
    border-radius: 6px;
    transform: rotate(-1deg);
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--tertidary-color);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.1rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .content-banner-home{
    width: 70%;
    margin: auto;
  }

  .banner-home{
    max-width: 100%;
    height: auto;
    border-radius: 20px 20px 0 0;
    /* box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08); */
  }
  /* Content Grid (Sidebar + Notes)*/
  .content-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
    align-items: start;
  }

  /* Sidebar categorias */

  .sidebar-sticky {
    position: sticky;
    top: 2rem; 
    background: var(--white-color);
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  .sidebar h3 {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
    border-bottom: 2px solid var(--background-color);
    padding-bottom: 0.5rem;
  }

  .category-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-btn {
    width: 100%;
    text-align: left;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--color-text-primary);
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background-color: var(--background-color);
    color: var(--tertidary-color);
  }

  .filter-btn.active {
    background-color: var(--secondary-color);
    color: var(--white-color);
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(68, 125, 75, 0.2);
  }

  /* Notes Area */
  .notes-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .notes-header h2 {
    font-size: 2rem;
    color: var(--color-text-secondary);
  }

  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 350px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
