  /* :root{
		--primary-color: #fdfcfa;
		--secondary-color: #447d4b;
		--tertidary-color:#08453c;
		--quaternary-color:#65e9f6;
        --background-color: #F4EEE5;
        --color-text-primary: #262626;
        --color-text-secondary: #141414;
        --color-text-light: #8a8989;
		--black-color: #000000;
		--white-color: #ffffff;
    --border-color: #E7E7E7;
	} */
	* {
		box-sizing: border-box;
		padding: 0;
		margin: 0;
	}

    .container-home{
        display: flex;
        flex-direction: column;
        gap: 4rem;
        margin-top: 5rem;
        align-items: center;
    }
  .section-one{
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 95%;
