  /**SECCION SUGERIR TEMA */

  .section-theme, .section-aboutme{
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
  }
  .section-theme div, .section-aboutme div{
      background-color: var(--background-color);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1.5rem;
      padding: 3rem;
      border-radius: 1rem;
      border: 1px solid var(--border-color);
      height: 40svh;
      width: 95%;
  }
  .section-theme h2, .section-aboutme h2{
