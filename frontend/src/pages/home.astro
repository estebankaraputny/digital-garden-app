---
import Layout from "../layouts/Layout.astro";
import fetchDataGet from "../lib/api/fetchDataGet";
import { Image } from "astro:assets";
import BannerHome from "../assets/image/bannerdg.png"

let notes = [];
let categories: any = [];

try {
  notes = await fetchDataGet("notes/all-notes");

  if (notes && notes.length > 0) {
    notes.sort((a: any, b: any) => 
      new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
    );
  }

  if (notes && notes.length > 0) {
    const categorySet = new Set();
    notes.forEach((note: any) => {
      if (note.category) {
        categorySet.add(note.category);
      }
    });
    categories = Array.from(categorySet);
  }

} catch (error) {
  console.error("Error cargando notas:", error);
}

const timeAgo = (dateString: string) => {
  if (!dateString) return '';
  
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  
  const rtf = new Intl.RelativeTimeFormat('es-AR', { numeric: 'auto' });

  if (diffInSeconds < 60) {
    return rtf.format(-diffInSeconds, 'second');
  }
  
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) {
    return rtf.format(-diffInMinutes, 'minute');
  }
  
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) {
    return rtf.format(-diffInHours, 'hour');
  }
  
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 30) {
    return rtf.format(-diffInDays, 'day');
  }
  
  const diffInMonths = Math.floor(diffInDays / 30);
  if (diffInMonths < 12) {
    return rtf.format(-diffInMonths, 'month');
  }
  
  const diffInYears = Math.floor(diffInDays / 365);
  return rtf.format(-diffInYears, 'year');
};

const ITEMS_PER_PAGE = 8;

---

<Layout title="Digital Garden - Home">
  <section class="home-container">
    
    <aside class="hero-section">
      <div class="hero-content">
        <h1>Digital <span class="highlight">Garden</span></h1>
        <p class="subtitle">Tu espacio para cultivar conocimientos.</p>
        <p class="description">
          Explora notas sobre tecnología, desarrollo y crecimiento personal. 
          Algunas notas son asistidas por IA para maximizar la precisión.
        </p>
        <div class="content-banner-home">
          <Image src={BannerHome} alt="" class="banner-home"/>
        </div>
      </div>
    </aside>

    <div class="content-grid">
      
      <aside class="sidebar">
        <div class="sidebar-sticky">
            <h3>Categorías</h3>
            <ul class="category-list">
            <li>
                <button class="filter-btn active" id="all">
                Todas
                </button>
            </li>
            {categories.map((category: string) => (
                <li>
                <button class="filter-btn" id={category.toLocaleLowerCase()}>
                    {category}
                </button>
                </li>
            ))}
            </ul>
        </div>
      </aside>

      <section class="notes-area">
        <div class="notes-header">
            <h2>Explora el jardín</h2>
            <div class="search-wrapper">
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/>
                </svg>
                <input type="search" placeholder="Buscar temas (ej: React Hooks)..." id="search-input"/>
            </div>
        </div>

        <div id="notes-container" class="notes-grid">
          {notes.map((note: any, index: number) => (

            <article 
              class={`note-card ${index >= ITEMS_PER_PAGE ? 'hidden' : ''}`} 
              id={note.id}
              data-category={note.category?.toLowerCase()}
              data-title={note.title.toLowerCase()}
              data-content={note.content.toLowerCase()}
            >
              <div class="card-header">
                <span class="category-badge">{note.category || 'General'}</span>
                <time datetime="${note.createdAt}" title="${new Date(note.createdAt).toLocaleString()}">
                    {timeAgo(note.createdAt)}
                </time>
              </div>
              
              <h3 class="card-title">{note.title}</h3>
              <p class="card-excerpt">{note.content.slice(0, 120)}...</p>
              
              <div class="card-footer">
                <button class="btn-read-more btn-view-note" id={note.id}>
                    Leer más →
                </button>
              </div>
            </article>
          ))}
        </div>

        {notes.length === 0 && <div class="empty-state"><p>No hay notas para mostrar.</p></div>}
        
        <div id="search-spinner" class="hidden spinner-container">
            <div class="spinner"></div>
        </div>

        <div id="no-results" class="hidden no-results-container">
            <p>No encontramos notas que coincidan con tu búsqueda.</p>
            <button id="clear-search-btn" class="btn-outline-small">Limpiar búsqueda</button>
        </div>
        <div id="pagination-controls" class="pagination-wrapper {notes.length <= ITEMS_PER_PAGE ? 'hidden' : ''}">
          <button id="prev-page-btn" class="btn-pagination" disabled>⬅ Anterior</button>
          <span id="page-info">Página 1 de 1</span>
          <button id="next-page-btn" class="btn-pagination">Siguiente ➡</button>
        </div>
      </section>
    </div>

    <section class="cta-dashboard">
        <div class="cta-banner highlight-banner">
            <div class="banner-content">
                <h2>¿Quieres ser autor?</h2>
                <p>Únete a nuestra comunidad y comparte tu saber con el mundo.</p>
                <button onclick="window.location.href='/register'" class="btn-primary">Postularme</button>
            </div>
        </div>

        <div class="cta-secondary-grid">
            <div class="cta-card">
                <p>Busca</p>
                <h3>Busca lo que necesitas</h3>
                <p>Utiliza el buscador para encontrar autores que hablen del tema</p>
                <button onclick="window.location.href='#search-input'" class="btn-outline">Pruébalo gratis</button>
            </div>
            <div class="cta-card">
                <p>Productividad</p>
                <h3>Alimenta tu saber</h3>
                <p>Comparte y adquiere conocimientos especificos de un tema. Tu aporte a la comunidad agrega valor a muchos otros.</p>
            </div>
        </div>
    </section>
    <section class="cta-future">
      <div class="cta-banner-ia">
        <div>
          <h2>Chat de IA para autores</h2>
          <p>
            Afina tus notas con ayuda de la IA, aprendes mientras compartes con tu cuente premium!
          </p>
        </div>
        <div>

        </div>
      </div>
      <div class="cta-banner-plans">
        <div>
          <h2>Planes</h2>
          <p>Disfruta de compartir tus conocimientos sin límites. Pronto podras a acceder al plan que desees. Mientras tanto disfruta el Gratuito!</p>
        </div>
        <div>

        </div>
      </div>
    </section>

  </section>
</Layout>

<script>
  
  document.addEventListener('DOMContentLoaded', () => {
    const cardView = document.querySelectorAll('.note-card');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const allCards = document.querySelectorAll('.note-card');
    const ITEMS_PER_PAGE = 8;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    let debounceTimer: ReturnType<typeof setTimeout>;
    const spinner = document.getElementById('search-spinner');
    const noResultsMsg = document.getElementById('no-results');
    const clearSearchBtn = document.getElementById('clear-search-btn');

    // 1. Ver detalles de nota
    cardView.forEach((button) => {
        button.addEventListener('click', (event) => {
            const currentCard = event.currentTarget as HTMLButtonElement;
            const idNote = currentCard.id;
            if (idNote) {
                localStorage.setItem('noteId', idNote);
                window.location.href = '/details-note';
            }
        });
    });

    // 2. Paginación (reemplaza "Cargar más")

    let currentCategory = 'all';
    let currentPage = 1;
    let totalPages = Math.max(1, Math.ceil(allCards.length / ITEMS_PER_PAGE));

    const paginationControls = document.getElementById('pagination-controls') as HTMLElement | null;
    const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
    const pageInfo = document.getElementById('page-info') as HTMLSpanElement | null;

    const computeFilteredCards = (selectedCat = currentCategory) => {
        return Array.from(allCards).filter(c => {
            const cardElement = c as HTMLElement;
            return selectedCat === 'all' || cardElement.dataset.category === selectedCat;
        });
    };

    const updatePaginationButtons = () => {
        const filtered = computeFilteredCards();
        totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
        if (paginationControls) {
            if (filtered.length <= ITEMS_PER_PAGE) paginationControls.classList.add('hidden');
            else paginationControls.classList.remove('hidden');
        }
        if (pageInfo) pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    };

    const renderPage = (page = 1) => {
        currentPage = Math.min(Math.max(1, page), totalPages);
        const filtered = computeFilteredCards();
        const start = (currentPage - 1) * ITEMS_PER_PAGE;
        const end = start + ITEMS_PER_PAGE;

        // Ocultar todo y mostrar solo el slice correspondiente
        Array.from(allCards).forEach((c) => (c as HTMLElement).classList.add('hidden'));

        filtered.forEach((card, idx) => {
            const el = card as HTMLElement;
            if (idx >= start && idx < end) el.classList.remove('hidden');
            else el.classList.add('hidden');
        });

        updatePaginationButtons();
    };

    if (prevBtn) prevBtn.addEventListener('click', () => { if (currentPage > 1) renderPage(currentPage - 1); });
    if (nextBtn) nextBtn.addEventListener('click', () => { if (currentPage < totalPages) renderPage(currentPage + 1); });

    // Inicializar visual
    renderPage(1);

    //Filtros
    filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            filterButtons.forEach(b => b.classList.remove('active'));
            const clickedBtn = e.currentTarget as HTMLElement;
            clickedBtn.classList.add('active');

            const selectedCat = clickedBtn.id; 
            currentCategory = selectedCat;
            currentPage = 1;
            renderPage(1);
        });
    });

    // Búsqueda
  const resetView = () => {
        searchInput.value = '';
        noResultsMsg?.classList.add('hidden');
        spinner?.classList.add('hidden');

        // Restaurar filtros visuales
        filterButtons.forEach(b => b.classList.remove('active'));
        document.getElementById('all')?.classList.add('active');

        currentCategory = 'all';
        currentPage = 1;
        renderPage(1);
    };

    // Evento del botón "Limpiar búsqueda" del mensaje de error
    clearSearchBtn?.addEventListener('click', resetView);

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);

            const searchTerm = searchInput.value.toLowerCase().trim();

            // ESTADO: ESCRIBIENDO
            // Si hay texto, mostramos spinner y ocultamos el mensaje de error previo
            if (searchTerm !== '') {
                spinner?.classList.remove('hidden');
                noResultsMsg?.classList.add('hidden');
                if (paginationControls) paginationControls.classList.add('hidden'); // Ocultar paginación mientras busca
            } else {
                resetView();
                return;
            }

            // Esperar a que termine de escribir
            debounceTimer = setTimeout(() => {
                
                // console.log("Buscando:", searchTerm);
                
                // Desactivar filtros de categorías visuales
                filterButtons.forEach(b => b.classList.remove('active'));

                let resultsCount = 0;

                allCards.forEach(card => {
                    const cardElement = card as HTMLElement;
                    const title = cardElement.dataset.title || '';
                    const content = cardElement.dataset.content || '';
                    const category = cardElement.dataset.category || '';

                    const isMatch = title.includes(searchTerm) || 
                                    content.includes(searchTerm) || 
                                    category.includes(searchTerm);

                    if (isMatch) {
                        cardElement.classList.remove('hidden');
                        resultsCount++;
                    } else {
                        cardElement.classList.add('hidden');
                    }
                });

                // FIN DE BÚSQUEDA
                // Ocultamos spinner
                spinner?.classList.add('hidden');

                // Mostrar mensaje si no hay resultados
                if (resultsCount === 0) {
                   noResultsMsg?.classList.remove('hidden');
                } else {
                   noResultsMsg?.classList.add('hidden');
                }

            }, 500);
        });
    }
  });
</script>

<style>
  
  * { 
    box-sizing: border-box; 
    margin: 0; 
    padding: 0; }
  
  .home-container {
    max-width: 1300px;
    margin: 3rem auto;
