  .section-theme p, .section-aboutme p{
      font-size: 1.2rem;
      color: var(--color-text-primary);
  }
  .section-theme button, .section-aboutme button{
      padding: 1rem 4rem;
      background-color: var(--secondary-color);
      color: var(--white-color);
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.3s ease;
      font-size: 1rem;
  }
  .section-theme button:hover, .section-aboutme button:hover{
