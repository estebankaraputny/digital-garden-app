---
import Layout from "../layouts/Layout.astro";
import fetchDataGet from "../lib/api/fetchDataGet";

let notes = [];
let categories: any = [];

try {
  notes = await fetchDataGet("notes");

  if (notes && notes.length > 0) {
    notes.sort((a: any, b: any) => 
      new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
    );
  }

  if (notes && notes.length > 0) {
        const categorySet = new Set();
        notes.forEach((note: any) => {
            if (note.category) {
                categorySet.add(note.category);
            }
        });
        categories = Array.from(categorySet);
    }

} catch (error) {
  console.error("Error cargando notas:", error);
}

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("es-AR", {
    weekday: "long", year: "numeric", month: "long", day: "numeric",
  });
};


const ITEMS_PER_PAGE = 10;

---

<Layout title="Digital Garden - Home">
  <main class="container-home">
    <section class="section-one">
      <h1>Digital <span>Garden</span></h1>
      <p>Encuentra notas de los temas que te interesan.</p>
      <p>Algunas notas estan creadas con IA. Realizamos busquedas para realizar notas lo más correctas posibles.</p>
    </section>
    <section class="content-asides">
      <aside class="aside-category">
        <h2>Categorías</h2>
        <div class="content-list-category">
          <ul class="list-category">
            <li>
              <button class="filter-btn active" id="all">
                Todas
              </button>
            </li>
            {
              categories.map((category: string) => {
                  return (
                      <li class="content-link-category">
                          <button class="filter-btn" id={category.toLocaleLowerCase()}>{category}</a>
                      </li>
                  )
              })
            }
          </ul>
        </div>
      </aside>
      <aside class="aside-notes">
          <h2>Últimas notas</h2>
        <div class="content-search">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z"/></svg>
            <label for="">
            <input type="search" name="" id="" placeholder="Hooks de React">
        </div>
        <div id="notes-container" class="container-notes">
          {
            notes.map((note: any, index: number) => (
              <article 
                class={`note-card ${index >= ITEMS_PER_PAGE ? 'hidden' : ''}`} 
                id={note.id}
                data-category={note.category}
              >
                <div>
                  <p class="note-category">{note.category}</p>
                </div>
                <h2 class="note-title">{note.title}</h2>

                <div class="note-content">
                  <p>{note.content.slice(0, 50)}...</p>         
                </div>
                <div class="note-footer">
                    <div>
                        <button class="btn-view-note" id={note.id}>Leer nota completa</button>
                    </div>
                    <time class="note-date" datetime={note.createdAt} class="date">
                    {formatDate(note.createdAt)}
                    </time>
                </div>
              </article>
            ))
          }
        </div>
          {notes.length === 0 && <p>No hay notas para mostrar.</p>}
          {notes.length > ITEMS_PER_PAGE && (
            <div class="pagination-container">
              <button id="load-more-btn">Cargar más notas</button>
            </div>
          )}


      </aside>
    </section>
    <section class="section-add">
      <div>
        <h2>¿Queres crear notas?</h2>
        <p>Envia tu postulación en el siguiente formulario.</p>
        <button onclick="window.location.href='/apply-author'">Postularme</button>
      </div>
    </section>
    <section class="section-theme">
      <div>
        <h2>¿No encontraste lo que buscabas?</h2>
        <p>Envianos tus sugerencias o temas de interés y los agregaremos a nuestro jardín digital.</p>
        <button onclick="window.location.href='/suggest-topic'">Sugerir tema</button>
      </div>
    </section>
    <section class="section-aboutme">
      <div>
        <h2>Tus pensamientos y saberes son valiosos para otros.</h2>
        <p>Comparte tus conocimientos creando y publicando tus propias notas en nuestro jardín digital.</p>
        <button onclick="window.location.href='/create-note'">Crear nota</button>
      </div>
    </section>
  </main>
</Layout>

<script>

  const loadMoreBtn = document.getElementById('load-more-btn');
  const buttons = document.querySelectorAll('.btn-view-note');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const allCards = document.querySelectorAll('.note-card');
  const ITEMS_PER_PAGE = 10;
  
buttons.forEach((button) => {
        
    button.addEventListener('click', (event) => {
        const currentBtn = event.currentTarget as HTMLButtonElement;
        const idNote = currentBtn.id;

        if (idNote) {
                console.log('ID de la nota:', idNote);
                
                // B. Guardamos en LocalStorage
                localStorage.setItem('noteId', idNote);
                
                // C. Redirigimos
                window.location.href = '/details-note';
            }
            else {
                console.error('No se encontró el ID de la nota.');
            }
    });
});

 const itemsPerPage = 10;

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
     
      const hiddenNotes = document.querySelectorAll('.note-card.hidden');

      if (hiddenNotes.length === 0) {
        loadMoreBtn.style.display = 'none';
        return;
      }

      for (let i = 0; i < itemsPerPage; i++) {
        if (hiddenNotes[i]) {
          hiddenNotes[i].classList.remove('hidden');
        }
      }

      const remainingHidden = document.querySelectorAll('.note-card.hidden');
      if (remainingHidden.length === 0) {
        loadMoreBtn.style.display = 'none';
      }
    });
  }


/**FILTROS DE CATEGORIAS */    

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();

        filterButtons.forEach(b => b.classList.remove('active'));
        (e.target as HTMLElement).classList.add('active');

        const selectedCat = (e.target as HTMLElement).id;

        if (loadMoreBtn) {
            if (selectedCat === 'all') {
                loadMoreBtn.style.display = 'block';
            } else {
                loadMoreBtn.style.display = 'none';
            }
        }

        allCards.forEach(card => {
          const cardElement = card as HTMLElement;
          const cardCat = cardElement.dataset.category?.toLowerCase();

          // mostrar solo 10 notas al filtrar en all y que muestre el boton de ver mas
          
          if (selectedCat.length > 0 && selectedCat !== 'all') {
              if (cardCat === selectedCat) {
                  cardElement.classList.remove('hidden');
              } else {
                  cardElement.classList.add('hidden');
              }
          } else {
              // Si es 'all', mostrar todas las notas
              const index = Array.from(allCards).indexOf(card);
              if (index < ITEMS_PER_PAGE) {
                  cardElement.classList.remove('hidden');
              } else {
                  cardElement.classList.add('hidden');
              }
          }
        });
      });
    });

    // if (loadMoreBtn) {
    //     loadMoreBtn.addEventListener('click', () => {
            
    //         const activeBtn = document.querySelector('.filter-btn.active') as HTMLElement;
    //         const currentCat = activeBtn ? activeBtn.dataset.category : 'all';

            
    //         const hiddenMatchingCards = Array.from(document.querySelectorAll('.note-card.hidden')).filter(card => {
    //             const cardElement = card as HTMLElement;
    //             // Si el filtro es 'all', devuelve true. Si no, compara categorías.
    //             return currentCat === 'all' || cardElement.dataset.category === currentCat;
    //         });

    //         // 3. Mostrar las siguientes 10
    //         for (let i = 0; i < ITEMS_PER_PAGE; i++) {
    //             if (hiddenMatchingCards[i]) {
    //                 hiddenMatchingCards[i].classList.remove('hidden');
    //             }
    //         }

    //         // 4. Si ya no quedan más ocultas de este tipo, esconder botón
    //         if (hiddenMatchingCards.length <= ITEMS_PER_PAGE) {
    //             loadMoreBtn.style.display = 'none';
    //         }
    //     });
    // }

    

</script>

<style>
	* {
		box-sizing: border-box;
		padding: 0;
		margin: 0;
	}

  .container-home{
        display: flex;
        flex-direction: column;
        gap: 4rem;
        margin-top: 5rem;
        align-items: center;
  }
  .section-one{
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 95%;
      background-color: var(--background-color);
      border-radius: 1rem;
      border: 1px solid #e6e6e6;
      height: 40svh;
      gap: 1.3rem;
      padding: 2rem;
  }
  .section-one h1{
    font-weight: 600;
    font-size: 3rem;
  }
  .section-one h1 span{

    background-color: var(--secondary-color);
    padding: .5rem 1rem;
    border-radius: 10px;
    color: var(--white-color);
  }
  .section-one p{
    font-size: 1.2rem;
    color: var(--color-text-primary);
  }
  .pagination-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  #load-more-btn {
    padding: 0.8rem 1.5rem;
    background-color: var(--tertidary-color);
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.3s ease;
  }
  #load-more-btn:hover {
    background-color: var(--secondary-color);
  }

  /* Info */
  .content-asides{
    display: flex;
    gap: 2rem;
    justify-content: center;
    width: 95%;
  }
  .aside-category {
    width: 20%;
    border-radius: 8px;
    height: fit-content;
  }
  h2 {
    font-size: 1.5rem;
  }
  .list-category{
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin-top: 1rem;
  }
  .filter-btn {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0;
    text-align: left;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    color: var(--secondary-color); 
  }
  .filter-btn.active {
    color: var(--secondary-color);
    font-weight: bold;
    text-decoration: underline;
  }
  .aside-notes{
    width: 75%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .content-search{
        display: flex;
        align-items: center;
        gap: .5rem;
        width: 100%;
  }

  .content-search svg{
        width: 1.2rem;
        height: auto;
        fill: var(--color-text-light);
  }
  .content-search label{
        font-size: .8rem;
        color: var(--color-text-light);
        width: 90%;
  }
  .content-search input{
        width: 70%;
        padding: .5rem;
        border-radius: 1rem;
        border: 1px solid #ccc;
  }
  .container-notes{
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .note-card {
    flex-basis: calc(50% - 1rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--white-color);
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: 8px;
    /* Animación suave al aparecer */
    animation: fadeIn 0.5s ease-in-out;
    gap: .5rem;
  }

   /* Clase para ocultar elementos */
  .hidden {
    display: none !important;
  }
  .note-category{
    font-size: .8rem;
    color: var(--color-text-light);
    font-weight: 600;
    /* text-align: end; */
  }
  .note-title{
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text-secondary);

  }
  .note-content{
        flex-grow: 1;
        margin: .5rem 0;
        color: var(--color-text-primary);
  }
  .note-footer{
        display: flex;
        justify-content: space-between;
        align-items: center;
  }
  .note-date{
        font-size: .8rem;
        color: var(--color-text-light);
  }
  .btn-view-note {
        padding: .5rem;
        background-color: var(--secondary-color); /* Ajusta a tu paleta */
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
        transition: background 0.3s ease;
  }
  .btn-view-note:hover {
        background-color: var(--tertidary-color);
  }

  /**SECCION CREAR CUENTA */
  .section-add{
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 2rem;
      width: 100%;
      text-align: center;
      color: var(--white-color);
      background-image: url(../assets/image/fondo-sectin-one.png);
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.418);
  }  
  .section-add div{
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      padding-top: 9rem;
      padding-bottom: 9rem ;
  }

  .section-add h2{
      font-size: 2rem;
      font-weight: 600;
      color: var(--white-color);
  }

  .section-add p{
      font-size: 1.2rem;
      color: var(--white-color);
  }
  .section-add button{
      padding: 1rem 4rem;
      background-color: #2fda43;
      color: var(--black-color);
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.3s ease;
      font-size: 1rem;
  }
  .section-add button:hover{
      background-color: #23b32f;
      color: var(--white-color);
  }

  /**SECCION SUGERIR TEMA */

  .section-theme, .section-aboutme{
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
  }
  .section-theme div, .section-aboutme div{
      background-color: var(--background-color);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1.5rem;
      padding: 3rem;
      border-radius: 1rem;
      border: 1px solid var(--border-color);
      height: 40svh;
      width: 95%;
  }
  .section-theme h2, .section-aboutme h2{
      font-size: 2rem;
      font-weight: 600;
      color: var(--color-text-secondary);
  }
  .section-theme p, .section-aboutme p{
      font-size: 1.2rem;
      color: var(--color-text-primary);
  }
  .section-theme button, .section-aboutme button{
      padding: 1rem 4rem;
      background-color: var(--secondary-color);
      color: var(--white-color);
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.3s ease;
      font-size: 1rem;
  }
  .section-theme button:hover, .section-aboutme button:hover{
      background-color: #23b32f;
  }

/**FRAMES */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>