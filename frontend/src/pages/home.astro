    font-weight: 600;
    font-size: 3rem;
  }
  .section-one h1 span{

    background-color: var(--secondary-color);
    padding: .5rem 1rem;
    border-radius: 10px;
    color: var(--white-color);
  }
  .section-one p{
    font-size: 1.2rem;
    color: var(--color-text-primary);
  }
  .pagination-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  #load-more-btn {
    padding: 0.8rem 1.5rem;
    background-color: var(--tertidary-color);
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
