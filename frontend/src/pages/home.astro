    margin-bottom: 4rem;
    border: 1px solid var(--border-color);
  }

  .hero-content h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }

  .highlight {
    color: var(--secondary-color);
    position: relative;
    z-index: 1;
  }
  
