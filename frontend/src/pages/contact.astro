<style>
  /* Contenedor Principal */
  .publish-container {
    max-width: 1000px;
    margin: 4rem auto;
    padding: 0 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
    color: var(--color-text-primary);
  }

  /* --- Hero Section --- */
  .hero-section {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero-section h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }

  .highlight {
    color: var(--secondary-color);
    position: relative;
  }
  
  /* Subrayado orgánico */
  .highlight::after {
    content: '';
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 100%;
    height: 8px;
    background-color: var(--quaternary-color);
    opacity: 0.3;
    z-index: -1;
    border-radius: 4px;
  }

  .hero-section p {
    font-size: 1.2rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* --- Plans Section --- */
  .plans-section {
    margin-bottom: 5rem;
  }
  
  .plans-section h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .plan-card {
    background: var(--white-color);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .plan-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    border-color: var(--secondary-color);
  }

  /* Tarjeta destacada (Básico) */
  .plan-card.featured {
    border: 2px solid var(--secondary-color);
    background-color: #fdfdfd;
  }

  .badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--secondary-color);
    color: white;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 0.3rem 0.8rem;
    border-bottom-left-radius: 10px;
  }

  .plan-card h3 {
    color: var(--color-text-secondary);
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 1rem 0;
  }

  .period {
    font-size: 1rem;
    color: var(--color-text-light);
    font-weight: normal;
  }

  .features {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    text-align: left;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .features li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  
  .features li:last-child {
    border-bottom: none;
  }

  /* --- Info Grid --- */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .info-card {
    background: var(--background-color); /* Fondo suave beige */
    padding: 2.5rem;
    border-radius: 16px;
  }

  .info-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--tertidary-color);
  }

  .info-card p {
    color: var(--color-text-primary);
    line-height: 1.6;
  }

  /* --- Form Section --- */
  .form-section {
    display: flex;
    justify-content: center;
  }

  .form-wrapper {
    background: var(--white-color);
    padding: 3rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    width: 100%;
    max-width: 600px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .form-wrapper h2 {
    text-align: center;
    color: var(--tertidary-color);
    margin-bottom: 0.5rem;
  }

  .form-wrapper > p {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  input, textarea {
    padding: 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background-color: var(--primary-color);
    transition: border-color 0.2s;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(68, 125, 75, 0.1);
  }

  textarea {
    resize: vertical;
  }

  .btn-submit {
    background-color: var(--secondary-color);
    color: white;
    padding: 1rem;
    font-size: 1rem;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    margin-top: 1rem;
  }

  .btn-submit:hover {
    background-color: var(--tertidary-color);
    transform: translateY(-1px);
  }

  .btn-submit:active {
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-section h1 { font-size: 2.2rem; }
    .info-grid { grid-template-columns: 1fr; }
    .form-wrapper { padding: 1.5rem; }
  }
</style>