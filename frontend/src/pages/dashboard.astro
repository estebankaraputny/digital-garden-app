---
import Layout from "../layouts/Layout.astro";
import FormNote from "../components/FormNote/FormNote.astro";
import Notes from "../components/Notes/Notes.astro";
import { Image } from "astro:assets";
import ImgProfile from "../assets/image/perfil.png"
---

<Layout title="Perfil de usuario | Digital Garden">
  <section class="dashboard-wrapper">
    
    <div class="dashboard-header">
      <div class="header-info">
        <div class="info-img">
          <Image src={ImgProfile} alt="Foto de perfil del usuario" id="img-profile" />
        </div>
        <div class="info-user">
          <h1 class="name-user" id="name-user">Esteban Karaputny</h1>
          <p class="description-user" id="description-user">Me gusta aprender, siempre soy curioso con lo que veo o escucho y investigo más.</p>
        </div>
      </div>
      <!-- <div>
        <button>Config</button>
      </div> -->
    </div>

    <div class="dashboard-grid">
      
      <section class="dashboard-card details-user">
        <div class="dashboard-profile-info">
          <div>
              <div><span>Notas</span></div>
              <div><span class="items-profile" id="count-notes-user">20</span></div>
          </div>
          <div>
            <div><span>Ranking</span></div>
            <div><span class="items-profile" id="ranking-user">1</span></div>
          </div>
          <div>
            <div><span>Plan</span></div>
            <div><span class="items-profile" id="plan-user">Gratuito</span></div>
          </div>
          <!-- <div>
            <div><span>Likes</span></div>
            <div><span class="items-profile" id="likes-user">10</span></div>
          </div>
          <div>

          </div> -->
        </div>
      </section>
      <section class="dashboard-card list-section">
        <div class="card-header">
          <h2>Crear Nota</h2>
          <p>Publica un nuevo conocimiento.</p>
        </div>
        <FormNote />
        <div class="card-header create-note">
          <h2>Tus Notas</h2>
          <p>Historial de publicaciones.</p>
        </div>
        <div class="notes-scroll-area">
          <Notes />
          
        </div>
      </section>

    </div>

  </section>
</Layout>

<script>
  
  const isAdmin = localStorage.getItem('isAdmin');
  if (isAdmin !== 'true') {
      window.location.href = '/'; 
  }
  import fetchDataGetWithToken from "../lib/api/fetchDataGetWithToken";
  import fetchDataPostWithToken from "../lib/api/fetchDataPostWithToken";

  const form = document.getElementById("note-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-message") as HTMLParagraphElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  // Lógica Crear Nota
  if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (errorMsg) {
            errorMsg.textContent = "";
            errorMsg.classList.add("hidden");
        }
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Cargando...";
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
          const myToken = localStorage.getItem("token");

          if (!myToken) throw new Error("No token found");

          const response = await fetchDataPostWithToken("notes", data, myToken);

          if (response && response.id) {
            window.location.href = "/dashboard";
          } else {
            throw new Error("Error al crear la nota");
          }
        } catch (error) {
          if (errorMsg) {
              errorMsg.textContent = "Credenciales incorrectas o error de servidor.";
              errorMsg.classList.remove("hidden");
          }
        } finally {
          if (btn) {
              btn.disabled = false;
              btn.textContent = "Crear Nota";
          }
        }
      });
  }

  //datos usuario
  const loadUserProfile = async () => {
    try {
      const myToken = localStorage.getItem("token");
      if (!myToken) return;

      // 1. Pedir datos al endpoint corregido
      const user = await fetchDataGetWithToken("user/profile", myToken);
      
      console.log("Datos de usuario obtenidos:", user);
      // 2. Verificar que llegó bien
      if (user && user.email) {
          // 3. Inyectar datos en el HTML
          const nameEl = document.getElementById("name-user");
          const descEl = document.getElementById("description-user");
          const planEl = document.getElementById("plan-user");
          const imgEl = document.getElementById("img-profile");

          if (nameEl) nameEl.textContent = user.name;
          // Si tuvieras descripción en la BD, la pones, si no, un texto default
          if (descEl) descEl.textContent = user.description || "Usuario de Digital Garden"; 
          if (planEl) planEl.textContent = user.plan || "Gratuito";
          
          // Opcional: Si tienes avatar
          // if (imgEl && user.avatar) imgEl.src = user.avatar;
      }

    } catch (error) {
      console.error("Error al obtener perfil:", error);
    }
  };

  // Ejecutar al cargar
  loadUserProfile();
</script>

<style>
  :root {
      --secondary-color: #447d4b;
      --tertiary-color: #08453c;
      --background-color: #F4EEE5;
      --white-color: #ffffff;
      --border-color: #E7E7E7;
      --color-text-primary: #262626;
      --color-text-light: #666666;
  }

  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .dashboard-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    font-family: 'Figtree', system-ui, sans-serif;
    color: var(--color-text-primary);
  }

  /* --- HEADER --- */
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
  }

  .header-info{
    display: grid;
    grid-template-columns: 300px 1fr;
    place-items: center;
    gap: 1rem;
  }

  .info-img{
    width: 250px;
    height: 250px;
  }

  .info-img img{
    width: 100%;
    height: 100%;
    border-radius:50%;
  }

  .info-user h1 {
    font-size: 2rem;
    font-weight: 700;
    max-width: 90%;
  }

  .info-user p {
    font-size: 1rem;
    color: var(--color-text-light);
    max-width: 90%;
  }

  .highlight {
    color: var(--secondary-color);
  }

  /* --- GRID LAYOUT --- */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr; /* Móvil: 1 columna */
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .dashboard-grid {
      /* Desktop: Izquierda 400px (Form), Derecha flexible (Lista) */
      grid-template-columns: 400px 1fr; 
    }
  }

  /* --- CARDS (Contenedores Blancos) --- */
  .dashboard-card {
    background-color: var(--white-color);
    border-radius: var(--border-radius);
    padding: 2rem;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .card-header {
    margin-bottom: 1.5rem;
    /* padding-bottom: 1rem; */
    border-bottom: 1px solid var(--border-color);
  }

  .card-header h2 {
    font-size: 1.3rem;
    color: var(--tertiary-color);
    margin-bottom: 0.2rem;
  }

  .card-header p {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .create-note{
    margin-top: 2rem;
  }

  /* Área de scroll para las notas si son muchas */
  .notes-scroll-area {
    /* Opcional: Si quieres que la lista tenga scroll interno */
    /* max-height: 800px;
    overflow-y: auto; */
  }

  .details-user{

  }

  .dashboard-profile-info{
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .dashboard-profile-info div{
    display: flex;
    justify-content: space-between;
  }

  .items-profile{
    color: var(--secondary-color);
    font-weight: 700;
  }
  /* Ajustes Responsive */
  @media (max-width: 900px) {
    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-info{
      grid-template-columns: 1fr;
      place-items: center;
    }
    .info-user{
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .card-header{
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1rem;
    }
    .info-user h1 {
      margin-bottom: .8rem;
    }
    .btn-logout {
      width: 100%;
      justify-content: center;
    }
    .dashboard-card {
        padding: 1.5rem;
    }

    
  }
  @media (max-width: 480px) {

  }
</style>