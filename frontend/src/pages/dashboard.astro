---
import Layout from "../layouts/Layout.astro";
import FormNote from "../components/FormNote/FormNote.astro";
import Notes from "../components/Notes/Notes.astro";
---

<Layout title="Perfil de usuario | Digital Garden">
  <div class="message-container hidden" id="message-container">
      <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M320 576C178.6 576 64 461.4 64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576zM320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320C528 205.1 434.9 112 320 112zM390.7 233.9C398.5 223.2 413.5 220.8 424.2 228.6C434.9 236.4 437.3 251.4 429.5 262.1L307.4 430.1C303.3 435.8 296.9 439.4 289.9 439.9C282.9 440.4 276 437.9 271.1 433L215.2 377.1C205.8 367.7 205.8 352.5 215.2 343.2C224.6 333.9 239.8 333.8 249.1 343.2L285.1 379.2L390.7 234z"/></svg>
      <p class="message-register" id="message-register"></p>
  </div>
  
  <section class="dashboard-wrapper">    
    <div class="dashboard-header">
      <div class="header-info">
        <div class="info-img" id="info-img">
          
        </div>
        <div class="info-user" id="info-user">
          <h1 class="name-user" id="name-user"></h1>
          <p class="description-user" id="description-user"></p>
        </div>
      </div>
      <!-- <div>
        <button>Config</button>
      </div> -->
    </div>

    <div class="dashboard-grid">
      
      <section class="dashboard-card details-user">
        <div class="dashboard-profile-info">
          <div>
              <div><span>Notas</span></div>
              <div><span class="items-profile" id="count-notes-user"></span></div>
          </div>
          <div>
            <div><span>Ranking</span></div>
            <div><span class="items-profile" id="ranking-user"></span></div>
          </div>
          <div>
            <div><span>Plan</span></div>
            <div><span class="items-profile" id="plan-user"></span></div>
          </div>
          <!-- <div>
            <div><span>Likes</span></div>
            <div><span class="items-profile" id="likes-user">10</span></div>
          </div>
          <div>

          </div> -->
        </div>
      </section>
      <section class="dashboard-card list-section">
        <div class="card-header">
          <h2>Crear Nota</h2>
          <p>Publica un nuevo conocimiento.</p>
        </div>
        <FormNote />
        <div class="card-header create-note">
          <h2>Tus Notas</h2>
          <p>Historial de publicaciones.</p>
        </div>
        <div class="notes-scroll-area">
          <Notes />
          
        </div>
      </section>

    </div>

  </section>
</Layout>

<script>
  import fetchDataGetWithToken from "../lib/api/fetchDataGetWithToken.ts";
  import fetchDataPostWithToken from "../lib/api/fetchDataPostWithToken.ts";
  
  // const isAdmin = localStorage.getItem('isAdmin');
  // if (isAdmin !== 'true') {
  //     window.location.href = '/'; 
  // }
  const form = document.getElementById("note-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-message") as HTMLParagraphElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  // Lógica Crear Nota
  if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (errorMsg) {
            errorMsg.textContent = "";
            errorMsg.classList.add("hidden");
        }
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Cargando...";
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
          const myToken = localStorage.getItem("token");

          if (!myToken) throw new Error("No token found");

          const response = await fetchDataPostWithToken("notes", data, myToken);

          if (response && response.id) {
            window.location.href = "/dashboard";
          } else {
            throw new Error("Error al crear la nota");
          }
        } catch (error) {
          if (errorMsg) {
              errorMsg.textContent = "Credenciales incorrectas o error de servidor.";
              errorMsg.classList.remove("hidden");
          }
        } finally {
          if (btn) {
              btn.disabled = false;
              btn.textContent = "Crear Nota";
          }
        }
      });
  }

  //datos usuario
  const loadUserProfile = async () => {
    try {
      const myToken = localStorage.getItem("token");
      if (!myToken) return;

      // 1. Pedir datos al endpoint corregido
      const user = await fetchDataGetWithToken("profile", myToken);
      
      //Saludo bienvenida inicio sesion
      const messageContainer = document.getElementById('message-container') as HTMLDivElement;
      const messageRegister = document.getElementById('message-register') as HTMLParagraphElement;

      const previousPage = document.referrer;
      const fromLogin = previousPage.includes('/login');


      if (fromLogin) {
          messageRegister.textContent = `Inicio de sesión exitoso. ¡Bienvenido, ${user.name}!`;
          messageContainer.classList.remove('hidden');
          setTimeout(() => {
              messageContainer.classList.add('message-container-hidden');
          }, 4000);

          if(messageContainer.classList.contains('message-container-hidden')){
              messageContainer.classList.remove('message-container-hidden');
              messageContainer.classList.add('hidden');
          }

      } else {
          messageContainer.classList.add('hidden');
      }
      
      const profileDate = document.getElementById("info-user");
          
      if (profileDate) {
          const descEl = document.getElementById("description-user") as HTMLParagraphElement;
          const nameEl = document.getElementById("name-user") as HTMLHeadingElement;
          const imgEl = document.getElementById("info-img") as HTMLElement;

          if (nameEl) nameEl.textContent = user.name || "Usuario de Digital Garden";
          if (descEl) descEl.textContent = user.description || "Usuario de Digital Garden"; 
          
          const userName = user.name || "Usuario";
          const initialUser = userName.charAt(0).toUpperCase();

          if (imgEl && user.avatar){
            imgEl.innerHTML = `<img src="${user.avatar}" alt="Foto de perfil del usuario ${user.name}" id="img-profile />`;
          } else if (imgEl) {
            imgEl.innerHTML = `<div class="avatar-circle-profile">${initialUser}</div>`;
          }
        }

    const cantNotesUser = await fetchDataGetWithToken("notes/user-notes/count", myToken);
      console.log(cantNotesUser,  "cantidad de notas");
      

      if (user) {
        const countNotesEl = document.getElementById("count-notes-user");
        if (countNotesEl) countNotesEl.textContent = cantNotesUser.count || "0";

        const rankingEl = document.getElementById("ranking-user");
        if (rankingEl) rankingEl.textContent = user.ranking || "Proximamente";

        const planEl = document.getElementById("plan-user");
        if (planEl) planEl.textContent = user.plan || "Gratuito";
      }

    } catch (error) {
      console.error("Error al obtener perfil:", error);
    }
  };

  // Ejecutar al cargar
  loadUserProfile();
</script> 

<style>
  :root {
      --secondary-color: #447d4b;
      --tertiary-color: #08453c;
      --background-color: #F4EEE5;
      --white-color: #ffffff;
      --border-color: #E7E7E7;
      --color-text-primary: #262626;
      --color-text-light: #666666;
  }

  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .message-container{
        position: fixed;
        max-width: 400px;
        width: 100%;
        padding: 2rem;
        top: 0%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: var(--white-color);
        padding: 1rem 2rem;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        text-align: center;
        z-index: 10000;
        animation: notificacionAlert 0.5s ease-in-out;
      }
      .message-container-hidden{
        animation: closeNotificacionAlert 0.5s ease-in-out forwards;
      }

    @keyframes notificacionAlert {
        0% {
            transform: translate(-50%, -150%);
            opacity: 0;
        }
        100% {
            transform: translate(-50%, -50%);
            opacity: 1;
        }
    }

    @keyframes closeNotificacionAlert {
      0% {
          transform: translate(-50%, -50%);
          opacity: 1;
      }
      100% {
          transform: translate(-50%, -150%);
          opacity: 0;
      }
    }

    .icon-check{
        display: inline-block;
        width: 4rem;
        height: 4rem;
        line-height: 1;
        color: var(--secondary-color);
        margin-top: 8rem;
        margin-bottom: .5rem;
        font-weight: bold;
        text-align: center;
    }

    .icon-check path {
        fill: currentColor;
    }
/**Mensaje inicio sesion */
    .message-register{
        margin-bottom: 1rem;
        font-size: 1.1rem;
        color: var(--color-text-primary);
    }

    .button-message{
        background-color: var(--secondary-color);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .button-message:hover{
        background-color: var(--tertiary-color);
    }

/*ESTILOS DEL PERFIL*/

  .dashboard-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    font-family: 'Figtree', system-ui, sans-serif;
    color: var(--color-text-primary);
  }

  /* --- HEADER --- */
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
  }

  .header-info{
    display: grid;
    grid-template-columns: 300px 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .info-img{
    width: 200px;
    height: 200px;
  }

  .info-img img{
    width: 100%;
    height: 100%;
    border-radius:50%;
  }

  :global(.avatar-circle-profile) {
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, var(--secondary-color), var(--tertiary-color));
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 5rem;
    flex-shrink: 0;
}

  .info-user h1 {
    font-size: 2rem;
    font-weight: 700;
    max-width: 90%;
  }

  .info-user p {
    font-size: 1rem;
    color: var(--color-text-light);
    max-width: 90%;
  }

  .highlight {
    color: var(--secondary-color);
  }

  /* --- GRID LAYOUT --- */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr; /* Móvil: 1 columna */
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {

    .info-user{
      max-width: 100%;
    }
    .dashboard-grid {
      /* Desktop: Izquierda 400px (Form), Derecha flexible (Lista) */
      grid-template-columns: 400px 1fr; 
    }
  }

  /* --- CARDS (Contenedores Blancos) --- */
  .dashboard-card {
    background-color: var(--white-color);
    border-radius: var(--border-radius);
    padding: 2rem;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .card-header {
    margin-bottom: 1.5rem;
    /* padding-bottom: 1rem; */
    border-bottom: 1px solid var(--border-color);
  }

  .card-header h2 {
    font-size: 1.3rem;
    color: var(--tertiary-color);
    margin-bottom: 0.2rem;
  }

  .card-header p {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .create-note{
    margin-top: 2rem;
  }

  /* Área de scroll para las notas si son muchas */
  .notes-scroll-area {
    /* Opcional: Si quieres que la lista tenga scroll interno */
    /* max-height: 800px;
    overflow-y: auto; */
  }

  .details-user{

  }

  .dashboard-profile-info{
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .dashboard-profile-info div{
    display: flex;
    justify-content: space-between;
  }

  .items-profile{
    color: var(--secondary-color);
    font-weight: 700;
  }


  /* Ajustes Responsive */
  @media (max-width: 900px) {
    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-info{
      grid-template-columns: 1fr;
      place-items: center;
    }
    .info-user{
      max-width: 100%;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .info-user h1, .info-user p {
      max-width: 100%;
    }

    .card-header{
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1rem;
    }
    .info-user h1 {
      margin-bottom: .8rem;
    }
    .btn-logout {
      width: 100%;
      justify-content: center;
    }
    .dashboard-card {
        padding: 1.5rem;
    }

    
  }
  @media (max-width: 480px) {

  }
</style>