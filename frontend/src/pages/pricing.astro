---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Planes de Suscripción">
  <div class="pricing-layout">
    
    <div class="plans-column">
      <div class="header-section">
        <h1>Mejora tu cuenta</h1>
        <p>Selecciona el plan que mejor se adapte a tu flujo de trabajo.</p>
      </div>

      <div class="plans-grid">
        <div class="plan-card"
            data-price-id={import.meta.env.PUBLIC_STRIPE_PRICE_ID_BASIC}
            data-name="Básico" 
            data-price="$4.99"
        >
          <div class="radio-circle"></div>
          <div class="plan-content">
             <h3>Básico</h3>
             <div class="price">$4,99 <span>/mes</span></div>
             <ul>
                 <li>Hasta <strong>15 notas</strong> al mes</li>
                <li>Perfil destacado</li>
                <li>Personalización del perfil</li>
             </ul>
          </div>
        </div>

        <div class="plan-card popular"
            data-price-id={import.meta.env.PUBLIC_STRIPE_PRICE_ID_PREMIUM} 
            data-name="Premium" 
            data-price="$19.99"
            >
          <div class="badge">Recomendado</div>
          <div class="radio-circle"></div>
          <div class="plan-content">
             <h3>Premium</h3>
             <div class="price">$19,99 <span>/mes</span></div>
             <ul>
                 <li>Agente de IA</li>
                <li>Hasta <strong>1000 notas</strong> al mes</li>
                <li>Mayor visibilidad</li>
                <li>Ranking</li>
                <li>Posicionamiento</li>
                <li>Soporte prioritario</li>
             </ul>
          </div>
        </div>

        <div class="plan-card dark" 
            data-price-id={import.meta.env.PUBLIC_STRIPE_PRICE_ID_UNLIMITED} 
            data-name="Ilimitado" 
            data-price="$39.99"
        >
          <div class="radio-circle"></div>
          <div class="plan-content">
             <h3>Ilimitado</h3>
             <div class="price">$39,99 <span>/mes</span></div>
             <ul>
                 <li>Notas <strong>ilimitadas</strong></li>
                  <li>Todas las funciones</li>
                  <li>Insignia especial</li>
                  <li>Acceso anticipado</li>
                  <li>Máxima visibilidad</li>
                  <li>Soporte VIP</li>
                  <li>Sin anuncios</li>
             </ul>
          </div>
        </div>
      </div>
    </div>

    <aside class="checkout-aside">
      <div class="aside-container">
        
        <div id="state-empty" class="state-view">
           <div class="icon-placeholder">💳</div>
           <h3>Selecciona un plan</h3>
           <p>Haz click en una tarjeta de la izquierda para ver los detalles de pago aquí.</p>
        </div>

        <div id="state-summary" class="state-view hidden">
            <div class="selected-summary">
                <span class="text-gray-500">Suscribiéndose a:</span>
                <div class="flex justify-between items-end border-b pb-4 mb-4">
                    <h2 id="summary-name-intermediate" class="text-2xl font-bold text-gray-800"></h2>
                    <span id="summary-price-intermediate" class="text-xl font-bold text-blue-600"></span>
                </div>
            </div>
            <button id="btn-proceed" class="btn-pay mt-4">
                Proceder al Pago
            </button>
            <p class="text-xs text-center text-gray-400 mt-4">
                Se creará una suscripción segura con Stripe.
            </p>
        </div>

        <div id="state-loading" class="state-view hidden">
            <div class="skeleton-title"></div>
            <div class="skeleton-price"></div>
            <div class="skeleton-form-line"></div>
            <div class="skeleton-form-block"></div>
            <div class="skeleton-button"></div>
        </div>

        <div id="state-payment" class="state-view hidden">
            <div class="selected-summary">
                <span class="text-gray-500">Suscribiéndose a:</span>
                <div class="flex justify-between items-end border-b pb-4 mb-4">
                    <h2 id="summary-name-payment" class="text-2xl font-bold text-gray-800">Plan</h2>
                    <span id="summary-price-payment" class="text-xl font-bold text-blue-600">$$</span>
                </div>
            </div>

            <div id="payment-element"></div>

            <div id="error-message" class="hidden text-red-500 text-sm mt-2 bg-red-50 p-2 rounded"></div>

            <button id="btn-pay" class="btn-pay mt-4 hidden">
                Confirmar y Pagar
            </button>
            
            <p class="text-xs text-center text-gray-400 mt-4">
                Pagos seguros encriptados por Stripe
            </p>
        </div>

      </div>
    </aside>

  </div>
</Layout>

<script src="https://js.stripe.com/v3/"></script>

<script>
  // Importa tu función API para obtener el clientSecret desde el backend
  import createSubscriptionIntent from '../lib/api/fetchDataPostStripe.ts';

  document.addEventListener('DOMContentLoaded', () => {
      console.log("🚀 Sistema de Pagos (Embedded) Cargado");

      const stripeKey = import.meta.env.PUBLIC_STRIPE_KEY;
      if (!stripeKey) console.error("❌ Falta PUBLIC_STRIPE_KEY");
      
      const stripe = Stripe(stripeKey);

      // Variables Globales
      let checkout = null;       
      let currentPriceId = '';

      // Referencias al DOM
      const planCards = document.querySelectorAll('.plan-card');
      const btnProceed = document.getElementById('btn-proceed');
      const btnPay = document.getElementById('btn-pay');
      const errorMsg = document.getElementById('error-message');

      // Elementos de Texto para Resumen
      const summaryElements = {
        nameInt: document.getElementById('summary-name-intermediate'),
        priceInt: document.getElementById('summary-price-intermediate'),
        namePay: document.getElementById('summary-name-payment'),
        pricePay: document.getElementById('summary-price-payment')
      };

      // Estados de UI
      const states = {
        empty: document.getElementById('state-empty'),
        summary: document.getElementById('state-summary'),
        loading: document.getElementById('state-loading'),
        payment: document.getElementById('state-payment')
      };

      // --- 1. SELECCIÓN DE PLAN ---
      planCards.forEach(card => {
        card.addEventListener('click', () => {
          const priceId = card.getAttribute('data-price-id');
          const name = card.getAttribute('data-name');
          const price = card.getAttribute('data-price');

          if (!priceId) return;
          
          currentPriceId = priceId;

          // Feedback visual
          planCards.forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');

          // Actualizar textos
          if (summaryElements.nameInt) summaryElements.nameInt.textContent = name;
          if (summaryElements.priceInt) summaryElements.priceInt.textContent = price;
          if (summaryElements.namePay) summaryElements.namePay.textContent = name;
          if (summaryElements.pricePay) summaryElements.pricePay.textContent = price;

          showState('summary');
        });
      });

      // --- 2. INICIAR CHECKOUT ---
      if (btnProceed) {
        btnProceed.addEventListener('click', async () => {
          if (!currentPriceId) return;
          
          showState('loading');
          const token = localStorage.getItem('token'); 

          if (!token) {
              window.location.href = '/login';
              return;
          }

          try {
            // A. Destruir instancia previa si existe
            if (checkout) {
                checkout.destroy();
                checkout = null;
            }

            // B. Obtener Client Secret del Backend (Checkout Session)
            console.log("📡 Solicitando sesión para:", currentPriceId);
            const data = await createSubscriptionIntent(currentPriceId, token);
            
            if (!data || !data.clientSecret) {
                throw new Error('No se recibió el secreto de sesión del servidor');
            }

            // C. Inicializar Stripe Embedded Checkout
            // IMPORTANTE: Usamos initCheckout, no elements()
            checkout = await stripe.initEmbeddedCheckout({
                clientSecret: data.clientSecret,
            });

            // D. Montar el Checkout
            // Al ser embedded, se monta todo el checkout aquí, no solo el 'payment element'
            checkout.mount('#payment-element');

            showState('payment');
            
            // NOTA: Con Embedded Checkout, Stripe suele pintar su propio botón de pago.
            // Si quieres usar tu botón personalizado 'btnPay', tendrías que ocultar el de Stripe
            // mediante CSS o configuración, pero por simplicidad, aquí dejamos que Stripe mande.
            // Si Stripe NO muestra botón (configuración custom), activamos el nuestro:
            
            // btnPay.classList.remove('hidden'); // Descomentar solo si configuras Stripe sin botón

          } catch (err) {
            console.error("❌ Error:", err);
            alert("Error al cargar el pago: " + (err.message || "Desconocido"));
            showState('summary');
          }
        });
      }

      // --- UTILS ---
      function showState(stateName) {
        Object.values(states).forEach(el => el?.classList.add('hidden'));
        if (states[stateName]) states[stateName].classList.remove('hidden');
      }
  });
</script>

<style>
  /* TUS ESTILOS ORIGINALES INTACTOS */
  .pricing-layout {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 2rem;
    max-width: 1200px;
    margin: 3rem auto;
    padding: 0 1.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .pricing-layout {
        grid-template-columns: 1fr;
    }
  }

  .header-section { margin-bottom: 2rem; }
  .header-section h1 { font-size: 2.5rem; color: var(--color-text-primary); }
  
  .plans-grid { display: flex; flex-direction: column; gap: 1rem; }

  .plan-card {
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .plan-card:hover { border-color: #cbd5e1; }
  
  .plan-card.selected {
    border-color: var(--secondary-color);
    background-color: #f0fdf4;
    box-shadow: 0 0 0 2px rgba(var(--secondary-color-rgb), 0.2);
  }

  .plan-card.selected .radio-circle {
    border-color: var(--secondary-color);
    background-color: var(--secondary-color);
    box-shadow: inset 0 0 0 3px white;
  }

  .radio-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #d1d5db;
    flex-shrink: 0;
    transition: all 0.2s;
  }

  .plan-content h3 { font-size: 1.2rem; font-weight: bold; margin: 0; }
  .plan-content .price { font-size: 1.5rem; font-weight: 800; color: var(--color-text-primary); }
  .plan-content ul { display: flex; gap: 1rem; list-style: none; padding: 0; font-size: 0.9rem; color: #6b7280; }

  .plan-card.popular .badge {
    position: absolute;
    top: 0; right: 0;
    background: var(--secondary-color);
    color: white;
    font-size: 0.7rem;
    padding: 0.2rem 0.8rem;
    border-bottom-left-radius: 8px;
  }

  .checkout-aside {
    position: sticky;
    top: 2rem;
  }

  .aside-container {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    min-height: 400px;
  }

  #state-empty {
    text-align: center;
    color: #9ca3af;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 350px;
  }
  .icon-placeholder { font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; }

  .skeleton-title { height: 24px; width: 60%; background: #e5e7eb; margin-bottom: 1rem; border-radius: 4px; animation: pulse 1.5s infinite; }
  .skeleton-price { height: 32px; width: 40%; background: #e5e7eb; margin-bottom: 2rem; border-radius: 4px; animation: pulse 1.5s infinite; }
  .skeleton-form-line { height: 40px; width: 100%; background: #e5e7eb; margin-bottom: 1rem; border-radius: 6px; animation: pulse 1.5s infinite; }
  .skeleton-form-block { height: 100px; width: 100%; background: #e5e7eb; margin-bottom: 1rem; border-radius: 6px; animation: pulse 1.5s infinite; }
  .skeleton-button { height: 48px; width: 100%; background: #e5e7eb; border-radius: 8px; animation: pulse 1.5s infinite; }

  @keyframes pulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
  }

  .btn-pay {
    width: 100%;
    background-color: var(--secondary-color);
    color: white;
    padding: 1rem;
    border-radius: 8px;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .btn-pay:hover { background-color: var(--tertidary-color); }
  .btn-pay:disabled { opacity: 0.7; cursor: not-allowed; }

  .hidden { display: none !important; }
</style>