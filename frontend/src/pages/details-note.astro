---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Detalle de Nota | Digital Garden">
  <section class="page-wrapper">
    
    <div id="loading" class="loading-container">
      <div class="spinner"></div>
      <p>Recuperando conocimiento...</p>
    </div>

    <div id="error" class="error-container hidden">
      <div class="error-box">
        <h2>⚠️ Nota no encontrada</h2>
        <p>Parece que esta hoja se ha perdido en el jardín.</p>
        <a href="/" class="btn-back">Volver al inicio</a>
      </div>
    </div>

    <div id="content" class="content-grid hidden">
      
        <article class="article-card">
            <header class="article-header">
                <div class="meta-top">
                    <a href="/home" class="btn-home">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M112 320C112 205.1 205.1 112 320 112C434.9 112 528 205.1 528 320C528 434.9 434.9 528 320 528C205.1 528 112 434.9 112 320zM576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576C461.4 576 576 461.4 576 320zM188.7 308.7C182.5 314.9 182.5 325.1 188.7 331.3L292.7 435.3C297.3 439.9 304.2 441.2 310.1 438.8C316 436.4 320 430.5 320 424L320 352L424 352C437.3 352 448 341.3 448 328L448 312C448 298.7 437.3 288 424 288L320 288L320 216C320 209.5 316.1 203.7 310.1 201.2C304.1 198.7 297.2 200.1 292.7 204.7L188.7 308.7z"/></svg>
                        Volver
                    </a>
                    <span id="note-category" class="category-pill">Categoría</span>
                    <time id="note-date" class="date-text">Fecha</time>
            </div>
            <h1 id="note-title" class="article-title">Título de la nota</h1>
            <div class="author-line">
                <span class="avatar-placeholder">👤</span>
                <span class="author-name">Por <strong id="note-author">Autor</strong></span>
            </div>
            </header>

            <hr class="divider" />

            <div class="article-body">
            <p id="note-body" class="body-text">
                </p>
            </div>

        <aside class="article-footer">
            <div class="share-box">
                <h3>¿Te sirvió esta nota?</h3>
                <p>Compártela con otros cultivadores digitales.</p>
                <div class="share-buttons">
                    <button class="btn-share copy">Copiar Link</button>
                    <button class="btn-share twitter">Compartir</button>
                </div>
            </div>
        </aside>
      </article>

      <aside class="sidebar">
        
        <div class="ad-container">
            <span class="ad-label">Publicidad</span>
            <div class="ad-placeholder">
                <p>Espacio para AdSense o Banner</p>
                </div>
        </div>

        <div class="widget-box">
            <h3>Más notas del usuario</h3>
            <p>Otros aportes que podrían interesarte de su jardín:</p>
            <ul class="related-list">
                <!-- <li><a href="/">Titulo 1</a></li>
                <li><a href="/">Titulo 2</a></li>
                <li><a href="/">Titulo 3</a></li> -->
            </ul>
        </div>

        <div class="widget-box highlight">
            <h3>🌱 Newsletter</h3>
            <p>Recibe las mejores notas en tu correo cada semana.</p>
            <button class="btn-subscribe">Suscribirme</button>
        </div>

      </aside>

    </div>
</section>
</Layout>

<script>
    import fetchDataGetById from "../lib/api/fetchDataGetById";
    import fetchDataGet from "../lib/api/fetchDataGet";

    async function loadNote() {
        const params = new URLSearchParams(window.location.search);
        const id = localStorage.getItem('noteId') || params.get('id');

        const loadingDiv = document.getElementById('loading');
        const contentDiv = document.getElementById('content');
        const errorDiv = document.getElementById('error');
   
        // Elementos a rellenar
        const titleEl = document.getElementById('note-title');
        const bodyEl = document.getElementById('note-body');
        const catEl = document.getElementById('note-category');
        const dateEl = document.getElementById('note-date');
        const authorEl = document.getElementById('note-author');

        // Helpers de formateo
        const formatDate = (dateString: string) => {
            if (!dateString) return "";
            return new Date(dateString).toLocaleDateString("es-AR", {
                year: "numeric", month: "long", day: "numeric"
            });
        };

        if (!id) {
            window.location.href = '/'; 
            return;
        }

        try {
            // console.log("Buscando nota con ID:", id);
            const note = await fetchDataGetById("notes", id);
            console.log(note);

            if (!note) throw new Error("Nota vacía");

            // Rellenar datos
            if(titleEl) titleEl.textContent = note.title;
            if(bodyEl) bodyEl.textContent = note.content;
            if(catEl) catEl.textContent = note.category || 'General';
            if(dateEl) dateEl.textContent = formatDate(note.createdAt);
            if(authorEl) authorEl.textContent = note.author?.profile.name || 'Anonimo';

            // Mostrar contenido
            loadingDiv?.classList.add('hidden');
            contentDiv?.classList.remove('hidden');

            // Preparar datos para compartir
            const shareUrl = `${location.origin}${location.pathname}?id=${encodeURIComponent(id)}`;
            const shareTitle = note.title || document.title || '';

            const copyBtn = document.querySelector('.btn-share.copy') as HTMLButtonElement | null;
            const instagramBtn = document.querySelector('.btn-share.twitter') as HTMLButtonElement | null;

            const resetButtonText = (btn: HTMLButtonElement, original: string, timeout = 2000) => {
                setTimeout(() => { btn.textContent = original; }, timeout);
            };

            if (copyBtn) {
                copyBtn.addEventListener('click', async () => {
                    const original = copyBtn.textContent || 'Copiar Link';
                    try {
                        await navigator.clipboard.writeText(shareUrl);
                        copyBtn.textContent = 'Copiado';
                        resetButtonText(copyBtn, original);
                    } catch (err) {
                        // Fallback viejo
                        const textarea = document.createElement('textarea');
                        textarea.value = shareUrl;
                        document.body.appendChild(textarea);
                        textarea.select();
                        try { document.execCommand('copy'); copyBtn.textContent = 'Copiado'; }
                        catch (e) { alert('No se pudo copiar automáticamente. Por favor selecciona y copia el enlace: ' + shareUrl); }
                        textarea.remove();
                        resetButtonText(copyBtn, original);
                    }
                });
            }

            if (instagramBtn) {
                instagramBtn.addEventListener('click', async () => {
                    // Preferir Web Share API (mostrará Instagram en móviles si está disponible)
                    if (navigator.share) {
                        try {
                            await navigator.share({ title: shareTitle, text: shareTitle, url: shareUrl });
                        } catch (e) {
                            // Compartir cancelado o fallido
                            const original = instagramBtn.textContent || 'Instagram';
                            instagramBtn.textContent = 'Error al compartir';
                            resetButtonText(instagramBtn, original);
                        }
                        return;
                    }

                    // Fallback: copiar enlace y abrir Instagram web
                    try {
                        await navigator.clipboard.writeText(shareUrl);
                        const original = instagramBtn.textContent || 'Instagram';
                        instagramBtn.textContent = 'Enlace copiado';
                        resetButtonText(instagramBtn, original);
                        window.open('https://www.instagram.com', '_blank');
                    } catch (err) {
                        // Si no se puede copiar, simplemente abrir Instagram
                        window.open('https://www.instagram.com', '_blank');
                        alert('Abriendo Instagram. Copia manualmente este enlace para compartir: ' + shareUrl);
                    }
                });
            }

            // --- Notas relacionadas (máx 3) ---
            try {
                const relatedListEl = document.querySelector('.related-list') as HTMLUListElement | null;

                const getAuthorIdFromNote = (noteObj: any) => {
                    return (
                        noteObj?.author?.id ||
                        noteObj?.author?.profile?.id ||
                        noteObj?.authorId ||
                        ''
                    );
                };

                const rawAuthorId = getAuthorIdFromNote(note);
                const authorId = rawAuthorId ? String(rawAuthorId) : '';

                if (relatedListEl && authorId) {
                    const triedEndpoints: string[] = [];
                    let relatedNotes: any[] = [];

                    // Intentar endpoint por usuario (que en tu proyecto parece existir)
                    const candidateEndpoints = [
                        
                        `notes?author=${encodeURIComponent(authorId)}`,
                        
                    ];

                    // for (const ep of candidateEndpoints) {
                    //     try {
                    //         triedEndpoints.push(ep);
                    //         const res = await fetchDataGet(`notes?author=${encodeURIComponent(authorId)}`);
                    //         let arr: any[] = [];

                    //         if (Array.isArray(res)) arr = res;
                    //         else if (Array.isArray(res.notes)) arr = res.notes;
                    //         else if (Array.isArray(res.data)) arr = res.data;
                    //         else if (res?.user && Array.isArray(res.user.notes)) arr = res.user.notes;
                    //         else if (res?.items && Array.isArray(res.items)) arr = res.items;

                    //         if (arr.length) { relatedNotes = arr; break; }
                    //     } catch (err) {
                    //         // ignore and continue
                    //     }
                    // }

                    // Fallback: si no se encontraron notas, traer todas y filtrar localmente
                    if (relatedNotes.length === 0) {
                        try {
                            triedEndpoints.push('notes/all-notes');
                            const all = await fetchDataGet('notes/all-notes');
                            if (Array.isArray(all)) {
                                relatedNotes = all.filter((n: any) => {
                                    const aid = String(n?.author?.id ?? n?.author?._id ?? n?.authorId ?? n?.userId ?? n?.user?._id ?? '');
                                    return aid === authorId;
                                });
                            } else if (Array.isArray(all?.notes)) {
                                relatedNotes = all.notes.filter((n: any) => String(n?.author?.id ?? n?.author?._id ?? n?.authorId ?? n?.userId ?? '') === authorId);
                            }
                        } catch (err) {
                            // ignore
                        }
                    }

                    // Filtrar la nota actual y limitar a 3
                    relatedNotes = relatedNotes.filter(n => String(n.id ?? n._id ?? n.noteId ?? n._id) !== String(id)).slice(0, 3);

                    if (relatedNotes.length === 0) {
                        relatedListEl.innerHTML = '<li>No hay más notas de este autor.</li>';
                        console.debug('Related notes empty. Tried endpoints:', triedEndpoints, 'authorId:', authorId);
                    } else {
                        relatedListEl.innerHTML = relatedNotes.map(n => {
                            const nid = encodeURIComponent(n.id ?? n._id ?? n.noteId ?? n._id);
                            const title = (n.title || 'Sin título').slice(0, 80);
                            const date = n.createdAt ? new Date(n.createdAt).toLocaleDateString('es-AR') : '';
                            return `<li>
                                    <a class="related-link" href="/details-note?id=${nid}" data-id="${nid}">${title}
                                        ${date ? ` — ${date}` : ''}
                                    </a>
                                </li>`;
                        }).join('');

                        // Asegurar navegación consistente: guardar noteId en localStorage y navegar
                        const anchors = relatedListEl.querySelectorAll('.related-link');
                        anchors.forEach(a => {
                            a.addEventListener('click', (e) => {
                                e.preventDefault();
                                const href = a.getAttribute('href') || '';
                                try {
                                    const url = new URL(href, location.origin);
                                    const nid = url.searchParams.get('id');
                                    if (nid) localStorage.setItem('noteId', nid);
                                } catch (err) {
                                    // fallback: usar data-id si parseo falla
                                    const nid = a.getAttribute('data-id');
                                    if (nid) localStorage.setItem('noteId', nid);
                                }
                                // Navegar a la página de detalles
                                window.location.href = href;
                            });
                        });
                    }
                } else if (relatedListEl) {
                    relatedListEl.innerHTML = '<li>No hay más notas de este autor.</li>';
                    console.debug('No authorId found on note', note);
                }
            } catch (err) {
                console.debug('Error cargando notas relacionadas:', err);
            }

        } catch (error) {
            // console.error(error);
            loadingDiv?.classList.add('hidden');
            errorDiv?.classList.remove('hidden');
        }
    }

    loadNote();
</script>

<style>
   * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    .page-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        min-height: 80vh;
    }

    .hidden { display: none !important; }

    /* --- LAYOUT GRID (Lo más importante) --- */
    .content-grid {
        display: grid;
        grid-template-columns: 1fr; /* Móvil: 1 columna */
        gap: 3rem;
    }

    @media (min-width: 900px) {
        .content-grid {
            /* Desktop: Contenido principal (2fr) + Sidebar (1fr) */
            grid-template-columns: 2fr 1fr;
            align-items: start;
        }
    }

    /* --- ESTILOS ARTÍCULO (IZQUIERDA) --- */
    .article-card {
        background-color: var(--white-color);
        padding: 3rem; /* Espaciado generoso tipo libro */
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .article-header { margin-bottom: 2rem; }

    .meta-top {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: #666;
    }
    .btn-home {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: row;
            gap: 0.5rem;
            color: var(--secondary-color);
            font-weight: 600;
            text-decoration: none;
            font-size: 0.75rem;
            color: var(--secondary-color);
    }

    .category-pill {
        background-color: #e8f5e9;
        color: var(--tertiary-color);
        padding: 0.3rem 0.8rem;
        border-radius: 99px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
    }

    .article-title {
        font-size: 2.5rem;
        line-height: 1.2;
        color: var(--color-text-primary);
        margin-bottom: 1rem;
        font-family: 'Figtree', serif;
    }

    .author-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        color: #555;
    }

    .divider {
        border: 0;
        height: 1px;
        background: var(--border-color);
        margin: 2rem 0;
    }

    .body-text {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #333;
        white-space: pre-line;
    }

    /* --- FOOTER DEL ARTICULO (VALOR) --- */
    .article-footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color);
    }

    .share-box {
        background-color: var(--background-color);
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
    }

    .share-box h3 { margin-bottom: 0.5rem; color: var(--tertiary-color); }
    
    .share-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 1rem;
    }

    .btn-share {
        padding: 0.5rem 1.2rem;
        border: 1px solid var(--secondary-color);
        background: transparent;
        color: var(--secondary-color);
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-share:hover {
        background: var(--secondary-color);
        color: white;
    }

    /* --- SIDEBAR (DERECHA) --- */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: sticky;
        top: 2rem; /* Se queda fija al scrollear si hay espacio */
    }

    /* ANUNCIOS */
    .ad-container {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .ad-label {
        font-size: 0.7rem;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .ad-placeholder {
        width: 100%;
        height: 250px; /* Tamaño estándar MPU */
        background-color: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        border-radius: 8px;
        border: 1px dashed #ccc;
    }

    /* WIDGETS */
    .widget-box {
        background: var(--white-color);
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid var(--border-color);
    }

    .widget-box.highlight {
        background-color: var(--secondary-color);
        color: white;
        border: none;
    }
    .widget-box.highlight p { color: #e0e0e0; }

    .widget-box h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    
    .related-list {
        list-style: none;
        margin-top: 1rem;
    }
    .related-list li {
        margin-bottom: 0.5rem;
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 0.5rem;
    }
    .related-list a, .related-link {
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 0.2s, background 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.45rem 0;
        border-radius: 6px;
    }
    .related-list a:hover, .related-link:hover {
        color: var(--secondary-color);
        background: rgba(68,125,75,0.05);
    }
    .related-list .related-date {
        font-size: 0.85rem;
        color: var(--color-text-light);
        margin-left: 0.5rem;
        font-weight: 600;
    }

    .btn-subscribe {
        width: 100%;
        margin-top: 1rem;
        padding: 0.8rem;
        background: white;
        color: var(--secondary-color);
        font-weight: bold;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    /* --- LOADING & ERROR --- */
    .loading-container, .error-container {
        text-align: center;
        padding: 4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid var(--secondary-color);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* Responsive */
    @media (max-width: 900px) {
        .article-card { padding: 1.5rem; }
        .article-title { font-size: 1.8rem; }
        .sidebar { position: static; } /* Quitar sticky en móvil */
        
        /* .page-wrapper {
            padding: 1rem 0;
        } */

        .article-card{
            border-radius: 0;
            border: none;
            box-shadow: none;
            padding: 0;
            width: 100%;
            background-color: transparent;
        }
        .meta-top{
            justify-content: space-between;
            gap: 0;
        }
        .category-pill{
            display: none;
        }

        .btn-home{
            justify-content: flex-start;
            gap: 0;
        }

        .body-text{
            font-size: 0.95rem;
        }
    }
</style>